# Where the /camp apply form POSTs JSON: { name, contact, discipline, level, msg, promo, camp }
# Leave empty: the application is handed over as an Instagram DM the rider sends (never a fake "sent").
PUBLIC_FORM_ENDPOINT=
# Optional promo-code check: POST { code, camp } → { valid: boolean, message?: string }.
# Leave empty: codes travel with the application and are checked by hand. Never price codes in the page.
PUBLIC_PROMO_ENDPOINT=
