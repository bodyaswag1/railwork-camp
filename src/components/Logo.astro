---
// The BAS CAMP logo (white lettering over the red rider, on Night Run): a patch that sits on any page colour.
// `full` adds the whole rider; sizes are set by the class of the place it sits in.
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/bas-camp-wordmark.png';
import full from '../assets/brand/bas-camp-logo.png';
interface Props { class?: string; full?: boolean; alt?: string; eager?: boolean; sizes?: string }
const { class: cls = '', full: whole = false, alt = '', eager = false, sizes = '120px' } = Astro.props;
---
<Image src={whole ? full : wordmark} alt={alt} class:list={['logo', cls]} widths={whole ? [240, 480, 900] : [96, 192, 384, 640]} sizes={sizes} format="webp" loading={eager ? 'eager' : 'lazy'} draggable="false" />
