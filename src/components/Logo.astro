---
// The BAS CAMP logo: the whole rider with the lettering across him, on a transparent background.
// `tone` is the page it sits on (white lettering needs a dark or red page; a red rider needs a non-red one);
// 'auto' renders all three and the masthead shows the one for the page under it (magazine.css).
import { Image } from 'astro:assets';
import onDark from '../assets/brand/bas-camp-on-dark.png';
import onLight from '../assets/brand/bas-camp-on-light.png';
import onRed from '../assets/brand/bas-camp-on-red.png';
interface Props { class?: string; tone?: 'dark' | 'light' | 'red' | 'auto'; alt?: string; eager?: boolean; sizes?: string }
const { class: cls = '', tone = 'dark', alt = '', eager = false, sizes = '120px' } = Astro.props;
const files = { dark: onDark, light: onLight, red: onRed };
const tones = tone === 'auto' ? (['dark', 'light', 'red'] as const) : [tone];
---
{tones.map((t, i) => (
  <Image src={files[t]} alt={i === 0 ? alt : ''} class:list={['logo', `logo--on-${t}`, cls]} widths={[64, 128, 256, 480, 720]} sizes={sizes} format="webp" loading={eager ? 'eager' : 'lazy'} draggable="false" />
))}
