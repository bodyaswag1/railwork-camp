---
// Photo credit for a picture we don't own (Wikimedia Commons): author, licence, link to the source.
import { credits, type PlacePhoto } from '../content/site';
interface Props { p: PlacePhoto; dark?: boolean }
const { p, dark = false } = Astro.props;
const cr = credits[p];
---
<small class:list={['credit', { 'credit--dark': dark }]}>Photo: <a href={cr.source} target="_blank" rel="noopener">{cr.author}</a>, {cr.licenseUrl ? <a href={cr.licenseUrl} target="_blank" rel="noopener license">{cr.license}</a> : cr.license}</small>
