---
// The black stage the paper crumples over. Back to front: stage → film (scratches, dust, desk light)
// → red/pink marks, splatter, note → (paper canvas, a sibling above this element).
// Compositions come from the Claude Design file (stage-set-1..3). Elements with a Figma original
// use the Figma vector (filled shapes, revealed through a DrawSVG-animated stroke mask).
import starRaw from '../assets/figma/punk_starburst.svg?raw';
import arrowRaw from '../assets/figma/snowboard_jump_arrow.svg?raw';

const parse = (raw: string) => ({
  viewBox: raw.match(/viewBox="([^"]+)"/)![1],
  paths: [...raw.matchAll(/<path[^>]*\sd="([^"]+)"/g)].map((m) => m[1]),
});
const star = parse(starRaw);
const arrow = parse(arrowRaw);
---
<div class="stage" aria-hidden="true" data-stage>
  <div class="stage__light"></div>
  <div class="stage__film" data-film><i></i><i></i><b></b><b></b></div>
  <div data-gate style="position:absolute;inset:0">
    <svg class="stage__marks" viewBox="0 0 1000 1000" preserveAspectRatio="none" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <g data-set="0" data-name="stage-set-1">
        <path data-tp data-name="loop-circle" vector-effect="non-scaling-stroke" d="M520 330 C 700 330, 720 480, 680 580 C 630 700, 380 700, 320 590 C 260 470, 360 330, 540 345 C 600 350, 650 380, 670 410" stroke="#BA1422" stroke-width="7" />
        <path data-tp data-name="speed-lines" vector-effect="non-scaling-stroke" d="M120 430 L 290 470 M100 510 L 280 515 M130 600 L 290 560" stroke="#FF94E3" stroke-width="6" />
        <path data-tp data-name="double-x" vector-effect="non-scaling-stroke" d="M150 150 L 230 230 M228 148 L 150 232 M260 170 L 310 220 M308 168 L 262 222" stroke="#BA1422" stroke-width="7" />
      </g>
      <g data-set="1" data-name="stage-set-2">
        <path data-tp data-name="tic-tac-toe" vector-effect="non-scaling-stroke" d="M160 120 L 150 330 M230 120 L 240 335 M90 190 L 310 180 M92 260 L 312 265" stroke="#BA1422" stroke-width="7" />
        <path data-tp data-name="tic-tac-toe-marks" vector-effect="non-scaling-stroke" d="M110 150 C 100 130, 140 120, 140 150 C 140 175, 105 175, 110 150 M180 210 L 215 245 M214 208 L 180 246" stroke="#FF94E3" stroke-width="6" />
        <path data-tp data-name="zigzag" vector-effect="non-scaling-stroke" d="M820 380 L 870 420 L 820 460 L 870 500 L 820 540 L 870 580 M850 380 L 900 420 L 850 460 L 900 500 L 850 540 L 900 580" stroke="#BA1422" stroke-width="7" />
        <path data-tp data-name="loop-circle" vector-effect="non-scaling-stroke" d="M500 320 C 675 320, 700 520, 575 645 C 450 733, 288 620, 325 470 C 350 370, 450 333, 525 335" stroke="#BA1422" stroke-width="7" />
      </g>
      <g data-set="2" data-name="stage-set-3">
        <path data-tp data-name="halo" vector-effect="non-scaling-stroke" d="M380 300 C 360 260, 640 250, 650 290 C 660 330, 360 340, 370 300" stroke="#FF94E3" stroke-width="6" />
        <path data-tp data-name="spiral" vector-effect="non-scaling-stroke" d="M220 150 C 250 135, 270 170, 240 195 C 200 220, 160 180, 180 135 C 200 90, 280 90, 300 140 C 320 195, 270 250, 210 250" stroke="#BA1422" stroke-width="7" />
        <path data-tp data-name="arrows-in" vector-effect="non-scaling-stroke" d="M140 300 C 220 360, 260 420, 330 480 M290 470 L 335 485 L 325 438 M880 820 C 780 760, 720 700, 660 620 M700 625 L 655 612 L 662 660" stroke="#BA1422" stroke-width="7" />
        <path data-tp data-name="underline" vector-effect="non-scaling-stroke" d="M150 760 L 420 740 M160 790 L 400 800" stroke="#FF94E3" stroke-width="6" />
        <path data-tp data-name="x-mark" vector-effect="non-scaling-stroke" d="M800 160 L 880 240 M878 158 L 800 242" stroke="#BA1422" stroke-width="7" />
      </g>
    </svg>

    <!-- Figma originals. set-1 starburst → punk_starburst; set-1 curve-arrow / set-2 arc-arrow → snowboard_jump_arrow -->
    <svg class="stage__fig" data-set="0" data-name="starburst" data-fig="star" viewBox={star.viewBox} style="left:72.5%;top:11%;width:min(19vw,30svh);aspect-ratio:1">
      <defs><mask id="m-star" maskUnits="userSpaceOnUse" x="0" y="0" width="666" height="666"><path data-tpm d="M333 333 m0 -300 a300 300 0 1 1 -0.1 0" stroke="#fff" stroke-width="620" fill="none" /></mask></defs>
      <g mask="url(#m-star)">{star.paths.map((d) => <path d={d} fill="#FF94E3" fill-rule="evenodd" />)}</g>
    </svg>
    <svg class="stage__fig" data-set="0" data-name="curve-arrow" data-fig="arrow-v" viewBox={arrow.viewBox} style="left:74%;top:50%;width:min(42svh,30vw);transform:translate(-30%,-50%) rotate(78deg)">
      <defs><mask id="m-arrow-v" maskUnits="userSpaceOnUse" x="-50" y="-50" width="2030" height="770"><path data-tpm d="M40 640 C 420 40, 1300 -60, 1900 260" stroke="#fff" stroke-width="320" fill="none" /></mask></defs>
      <g mask="url(#m-arrow-v)">{arrow.paths.map((d) => <path d={d} fill="#BA1422" fill-rule="evenodd" />)}</g>
    </svg>
    <svg class="stage__fig" data-set="1" data-name="arc-arrow" data-fig="arrow-h" viewBox={arrow.viewBox} style="left:12%;top:66%;width:76%;height:24%">
      <defs><mask id="m-arrow-h" maskUnits="userSpaceOnUse" x="-50" y="-50" width="2030" height="770"><path data-tpm d="M40 640 C 420 40, 1300 -60, 1900 260" stroke="#fff" stroke-width="320" fill="none" /></mask></defs>
      <g mask="url(#m-arrow-h)">{arrow.paths.map((d) => <path d={d} fill="#FF94E3" fill-rule="evenodd" />)}</g>
    </svg>

    <svg class="stage__splat" data-splat data-name="stage-splatter" viewBox="0 0 240 170">
      <circle cx="72" cy="68" r="16" fill="#BA1422" /><circle cx="139.2" cy="47.6" r="6" fill="#BA1422" />
      <circle cx="177.6" cy="98.6" r="10" fill="#BA1422" /><circle cx="110.4" cy="125.8" r="5" fill="#FF94E3" />
      <circle cx="211.2" cy="37.4" r="3" fill="#BA1422" /><circle cx="38.4" cy="136" r="4" fill="#FF94E3" />
      <circle cx="220.8" cy="142.8" r="4" fill="#BA1422" />
    </svg>
    <div class="stage__note marker" data-note data-name="stage-note">next!</div>
  </div>
</div>
