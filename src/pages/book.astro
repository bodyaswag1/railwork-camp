---
// Booking, in GameChanger's order: what (trampoline, personal, camp), then when (a day strip and that day's
// times), then a confirm sheet. The confirmation is where a personal session can become a weekly slot.
// Browsing works signed out; reserving needs an account. Pay your coach on the day.
import App from '../layouts/App.astro';
import { ICON } from '../members/icons';
import { train } from '../content/site';
---
<App title="Book" path="/book" nav>
  <div class="pagehead">
    <div>
      <h1>Book a session</h1>
      <p class="lede">Reserve now, pay your coach on the day. Free changes until 48 hours before.</p>
    </div>
  </div>

  <section aria-labelledby="what-h">
    <h2 id="what-h" class="sr-only">What do you want to book?</h2>
    <div class="kinds" role="radiogroup" aria-label="Kind of session">
      <button class="kind" type="button" role="radio" data-kind="trampoline" aria-checked="false">
        <span class="photo photo--empty kind__photo"><span><Fragment set:html={ICON.camera} />Trampoline photo</span></span>
        <span class="kind__body"><b>Trampoline</b><span>Small group at the hall. Air awareness, spins and grabs before you take them to snow.</span></span>
      </button>
      <button class="kind" type="button" role="radio" data-kind="personal" aria-checked="false">
        <span class="photo photo--empty kind__photo"><span><Fragment set:html={ICON.camera} />Slope photo</span></span>
        <span class="kind__body"><b>Personal session</b><span>Ilia next to you on the slope. {train.coaching.price} an hour or {train.coaching.day}. Can repeat every week.</span></span>
      </button>
      <a class="kind" href="/camps">
        <span class="photo photo--empty kind__photo"><span><Fragment set:html={ICON.camera} />Camp photo</span></span>
        <span class="kind__body"><b>Camps</b><span>A group, one place, several days of coaching and filming. Apply in the app.</span></span>
      </a>
    </div>
  </section>

  <p class="card card--quiet small" id="pack-note" style="margin-top:var(--gap)" hidden></p>

  <section class="section" id="when" aria-labelledby="when-h" hidden>
    <div class="section__head"><h2 id="when-h">Pick a day</h2><span class="meta" id="when-count"></span></div>
    <div class="days" id="days" role="tablist" aria-label="Days"></div>
    <div class="card card--flush" style="margin-top:12px">
      <ul class="rows" id="slots"></ul>
    </div>
    <p class="empty" id="empty" hidden>Nothing open in the next 8 weeks yet. <a href="https://instagram.com/baskakov74">Message Ilia</a> and he sets a day up with you.</p>
  </section>
</App>

<style is:global>
  .kinds { display: grid; gap: 10px; }
  @media (min-width: 760px) { .kinds { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); } }
  .kind {
    display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 14px; align-items: center;
    padding: 10px; text-align: left; font: inherit; color: inherit; text-decoration: none; cursor: pointer;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card);
    transition: border-color .15s, box-shadow .15s;
  }
  .kind:hover { border-color: var(--control); }
  .kind[aria-checked='true'] { border-color: var(--text); box-shadow: inset 0 0 0 1px var(--text); }
  .kind .kind__photo { aspect-ratio: 1; border-radius: 6px; }
  .kind .kind__photo > span { font-size: 0; padding: 6px; gap: 0; }
  .kind__body b { display: block; font-size: 16px; font-weight: 600; margin-bottom: 2px; }
  .kind__body span { display: block; font-size: 13px; color: var(--faint); line-height: 1.4; }
  @media (min-width: 760px) {
    .kind { grid-template-columns: 1fr; padding: 0; overflow: hidden; align-items: stretch; }
    .kind .kind__photo { aspect-ratio: 16 / 9; border-radius: 0; }
    .kind .kind__photo > span { font-size: 12px; padding: 4px 8px; gap: 6px; }
    .kind__body { padding: 12px 16px 16px; }
  }
  /* once a kind is picked, the three cards shrink to a one-line switch on a phone so the days come up */
  @media (max-width: 759px) {
    .kinds--picked { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    .kinds--picked .kind { grid-template-columns: 1fr; padding: 10px 6px; text-align: center; min-height: 48px; }
    .kinds--picked .kind .kind__photo, .kinds--picked .kind__body span { display: none; }
    .kinds--picked .kind__body b { font-size: 14px; margin: 0; }
  }
  .days { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 2px; margin: 0 -2px; }
  .days::-webkit-scrollbar { display: none; }
  .day {
    flex: none; width: 56px; padding: 8px 0 7px; display: grid; justify-items: center; gap: 3px;
    border: 1px solid var(--border); border-radius: var(--r-control); background: var(--surface); color: var(--text); font: inherit; cursor: pointer;
  }
  .day small { font: 600 11px/1 var(--font-body); color: var(--faint); text-transform: uppercase; }
  .day b { font: 900 22px/1 var(--font-display); font-stretch: 62%; }
  .day i { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .day[aria-selected='true'] { background: var(--night-run); border-color: var(--night-run); color: #fff; }
  .day[aria-selected='true'] small { color: #c9d1d6; }
  .day[aria-selected='true'] i { background: #fff; }
  .slotrow .row__end { min-width: 0; }
  .seats { font-size: 12px; color: var(--faint); }
</style>

<script>
  import { $, $$, esc, paintHeader, sheet, toast } from '../members/ui';
  import { BOOK_RESULT, KIND, TZ, euro, time } from '../members/labels';
  import { levelName } from '../lib/members/rules';
  import { configured, loadMe, sb } from '../members/sb';
  import { dayKey, keyDate, type Open } from '../members/timeline';

  if (!configured) document.body.dataset.unconfigured = '';
  const me = await loadMe();
  paintHeader(me);
  const params = new URLSearchParams(location.search);
  let kind = params.get('kind') ?? '';
  let day = params.get('day') ?? '';
  let rows: Open[] = [];
  let credits: Record<string, number> = {};

  function setUrl() {
    const q = new URLSearchParams();
    if (kind) q.set('kind', kind);
    if (day) q.set('day', day);
    history.replaceState(null, '', `${location.pathname}${q.size ? '?' + q : ''}`);
  }

  async function load() {
    for (const b of $$<HTMLButtonElement>('button[data-kind]')) b.setAttribute('aria-checked', String(b.dataset.kind === kind));
    $('#when').hidden = !kind;
    $('.kinds').classList.toggle('kinds--picked', !!kind);
    if (!kind) return;
    const { data } = await sb.rpc('open_sessions', { p_kind: kind });
    rows = (data ?? []) as Open[];
    const days = [...new Set(rows.map((s) => dayKey(s.starts_at)))];
    if (!days.includes(day)) day = days.find((k) => rows.some((s) => dayKey(s.starts_at) === k && s.seats_left > 0 && !s.my_booking)) ?? days[0] ?? '';
    paint(days);
    setUrl();
  }

  function paint(days: string[]) {
    const free = rows.filter((s) => s.seats_left > 0 && !s.my_booking).length;
    $('#when-count').textContent = rows.length ? `${free} open in the next 8 weeks` : '';
    $('#days').innerHTML = days.map((k) => {
      const d = keyDate(k);
      const any = rows.some((s) => dayKey(s.starts_at) === k && s.seats_left > 0 && !s.my_booking);
      return `<button class="day" type="button" role="tab" data-day="${k}" aria-selected="${k === day}" aria-label="${esc(d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }))}">
        <small>${esc(d.toLocaleDateString('en-GB', { weekday: 'short' }))}</small><b>${d.getDate()}</b>${any ? '<i></i>' : '<i style="visibility:hidden"></i>'}</button>`;
    }).join('');
    const list = rows.filter((s) => dayKey(s.starts_at) === day);
    $('#slots').innerHTML = list.map((s) => {
      const lvl = s.level_min ? `${levelName(s.level_min)}${s.level_max ? ` – ${levelName(s.level_max)}` : ' and up'}` : '';
      const seats = s.kind === 'trampoline' ? `${s.seats_left} of ${s.capacity} places left` : '';
      const action = s.my_booking ? '<span class="pill pill--accent">You are booked</span>'
        : s.seats_left <= 0 ? '<span class="pill">Full</span>'
        : `<button class="btn btn--small" type="button" data-pick="${s.id}">${me ? 'Reserve' : 'Sign in to book'}</button>`;
      return `<li class="slotrow row--wrap">
        <span class="daystub${s.my_booking ? ' daystub--mine' : ''}"><small>${esc(time(s.starts_at))}</small><b>${Math.round((new Date(s.ends_at).getTime() - new Date(s.starts_at).getTime()) / 6e4)}</b><small>min</small></span>
        <span class="row__main"><b>${esc(s.title)}</b>
          <span class="row__sub">${esc([s.venue, s.coach && `with ${s.coach}`, euro(s.price_eur), lvl].filter(Boolean).join(' · '))}</span>
          ${seats ? `<span class="seats">${esc(seats)}</span>` : ''}${s.notes ? `<span class="row__sub">${esc(s.notes)}</span>` : ''}</span>
        <span class="row__end">${action}</span></li>`;
    }).join('');
    $('#empty').hidden = rows.length > 0;
    $('#slots').closest('.card')!.toggleAttribute('hidden', !rows.length);
  }

  document.addEventListener('click', async (e) => {
    const t = e.target as Element;
    const k = t.closest<HTMLButtonElement>('button[data-kind]');
    if (k) { kind = k.dataset.kind!; day = ''; return load(); }
    const d = t.closest<HTMLButtonElement>('[data-day]');
    if (d) { day = d.dataset.day!; paint([...new Set(rows.map((s) => dayKey(s.starts_at)))]); setUrl(); return; }
    const p = t.closest<HTMLButtonElement>('[data-pick]');
    if (p) {
      if (!me) { location.href = `/signin?next=${encodeURIComponent(location.pathname + location.search)}`; return; }
      return confirmSheet(rows.find((s) => s.id === p.dataset.pick)!);
    }
  });

  function confirmSheet(s: Open) {
    const sh = sheet('confirm', 'Reserve this session');
    const when = new Date(s.starts_at).toLocaleDateString('en-GB', { timeZone: TZ, weekday: 'long', day: 'numeric', month: 'long' });
    const credit = credits[s.kind] ?? 0;
    sh.body.innerHTML = `<dl class="facts">
        <dt>What</dt><dd>${esc(s.title)}</dd>
        <dt>When</dt><dd>${esc(when)}, ${esc(time(s.starts_at))}–${esc(time(s.ends_at))}</dd>
        ${s.venue ? `<dt>Where</dt><dd>${esc(s.venue)}</dd>` : ''}
        ${s.coach ? `<dt>Coach</dt><dd>${esc(s.coach)}</dd>` : ''}
        <dt>Pay</dt><dd>${credit ? `One credit from your pack (${credit} left)` : s.price_eur ? `${esc(euro(s.price_eur))} to your coach on the day` : 'Your coach tells you'}</dd>
      </dl>
      <p class="small faint">Free changes until 48 hours before. After that, message your coach.</p>
      <div class="actions" style="margin-top:16px"><button class="btn btn--block" type="button" id="do-book">Reserve</button></div>`;
    sh.open();
    $('#do-book').addEventListener('click', async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      const { data, error } = await sb.rpc('book_session', { p_session: s.id });
      const status = error ? 'error' : data.status;
      if (status !== 'ok') { btn.disabled = false; toast(BOOK_RESULT[status] ?? 'That did not go through. Try again.', 'bad'); return; }
      // done: a personal session can turn into a weekly slot right here
      sh.el.querySelector('h2')!.textContent = 'You are booked';
      sh.body.innerHTML = `<p><b>${esc(when)}, ${esc(time(s.starts_at))}</b> · ${esc(s.title)}</p>
        <p class="small faint">${data.pack ? 'Paid with a credit from your pack.' : 'Your spot is held. Pay your coach on the day.'}</p>
        ${s.kind ? `<div class="card card--quiet" style="margin:16px 0 0"><b>Same time every week?</b>
          <p class="small faint" style="margin:4px 0 10px">Ask for a weekly slot and your coach books it 4 weeks ahead. Skip a week any time with a trip.</p>
          <button class="btn btn--small btn--ghost" type="button" id="ask-loop" data-booking="${data.booking ?? ''}">Ask for a weekly slot</button></div>` : ''}
        <div class="actions" style="margin-top:16px"><a class="btn" href="/me/sessions">See my sessions</a><button class="link" type="button" data-close>Book another</button></div>`;
      $('#ask-loop')?.addEventListener('click', async (e2) => {
        const b = e2.currentTarget as HTMLButtonElement;
        let id = b.dataset.booking;
        if (!id) {
          const { data: mine } = await sb.from('bookings').select('id').eq('session_id', s.id).neq('status', 'cancelled').limit(1);
          id = mine?.[0]?.id;
        }
        const { data: r } = await sb.rpc('request_loop', { p_booking: id });
        toast(r === 'ok' ? 'Asked. Your coach checks the time and confirms.' : r === 'already' ? 'You already have this weekly slot.' : 'Could not ask.', r === 'ok' ? 'ok' : 'bad');
        b.disabled = true;
      });
      load();
    });
  }

  if (me) {
    const { data: packs } = await sb.from('packs').select('kind, sessions_total, sessions_used, valid_until');
    for (const p of packs ?? []) if (p.sessions_used < p.sessions_total) credits[p.kind] = (credits[p.kind] ?? 0) + p.sessions_total - p.sessions_used;
    const live = Object.entries(credits);
    if (live.length) {
      $('#pack-note').textContent = 'Your packs: ' + live.map(([k, n]) => `${n} ${KIND[k].toLowerCase()} credit${n === 1 ? '' : 's'} left`).join(', ') + '. Booking uses a credit automatically.';
      $('#pack-note').hidden = false;
    }
  }
  await load();
</script>
