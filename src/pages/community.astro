---
// Crew: an overview first (faces, rides, feed, your own card), then the full lists: riders who chose to be visible,
// "ride together" posts, what happened around the crew, and what the crew
// noticed this month. Everything is off by default; turning it on is one switch here or in settings.
// No results, no standings, no rankings.
import App from '../layouts/App.astro';
import { LEVELS } from '../lib/members/rules';
import { ICON } from '../members/icons';
---
<App title="Crew" path="/community" nav>
  <div class="pagehead">
    <div>
      <h1>Crew</h1>
      <p class="lede">Riders who chose to be seen. Levels are confirmed by coaches; nobody is ranked.</p>
    </div>
  </div>

  <section class="card card--tint optin" id="optin" hidden>
    <div><b>Only your coach can see you right now.</b>
      <p class="small" style="margin:4px 0 0">Join the crew and riders at your level can find you. Your contact details stay private until you both say yes.</p></div>
    <div class="actions"><button class="btn btn--small" type="button" id="go-listed">Show me in the crew</button><a class="link small" href="/me/settings#privacy">Privacy</a></div>
  </section>

  <nav class="utabs" role="tablist" aria-label="Crew">
    <a href="#" role="tab" data-tab="home" aria-selected="true">Overview</a>
    <a href="#riders" role="tab" data-tab="riders" aria-selected="false">Riders</a>
    <a href="#ride" role="tab" data-tab="ride" aria-selected="false">Rides</a>
    <a href="#feed" role="tab" data-tab="feed" aria-selected="false">Feed</a>
    <a href="#highlights" role="tab" data-tab="highlights" aria-selected="false">Highlights</a>
  </nav>

  <section data-pane="home" aria-label="Overview">
    <div class="card card--tint asks" id="ov-asks" hidden></div>
    <div class="crewgrid">
      <div class="stack">
        <section class="card">
          <div class="card__head"><h2>Riders</h2><a href="#riders" data-go="riders">See all</a></div>
          <div class="faces" id="ov-faces"></div>
          <p class="small faint" id="ov-faces-empty" hidden>Nobody listed yet. Join the crew and you give the next rider someone to find.</p>
        </section>
        <section class="card card--flush">
          <div class="card__head"><h2>Ride together</h2><button class="btn btn--small" type="button" data-post>Post a ride</button></div>
          <ul class="rows" id="ov-board"></ul>
          <p class="card__more"><a href="#ride" data-go="ride">All rides</a></p>
        </section>
        <section class="card card--flush">
          <div class="card__head"><h2>Around the crew</h2><a href="#feed" data-go="feed">See all</a></div>
          <ul class="rows" id="ov-feed"></ul>
        </section>
      </div>
      <div class="stack">
        <section class="card mecard" id="ov-me" aria-label="You in the crew"></section>
        <section class="card">
          <div class="card__head"><h2>From the slope</h2></div>
          <div class="wall">
            {[0, 1, 2, 3, 4, 5].map(() => <div class="photo photo--square photo--empty"><span><Fragment set:html={ICON.camera} /></span></div>)}
          </div>
          <p class="small faint" style="margin-top:12px">Session and camp photos from your coach land here.</p>
        </section>
        <section class="card" id="ov-month">
          <div class="card__head"><h2>This month</h2><a href="#highlights" data-go="highlights">Highlights</a></div>
          <div class="figs" style="--cols:3" id="ov-figs"></div>
        </section>
      </div>
    </div>
  </section>

  <section data-pane="riders" aria-label="Riders">
    <div class="toolbar">
      <select id="f-disc" class="sel-inline" aria-label="Discipline"><option value="">Snowboard + ski</option><option value="snowboard">Snowboard</option><option value="ski">Ski</option></select>
      <select id="f-band" class="sel-inline" aria-label="Level"><option value="">Any level</option>{LEVELS.map((l) => <option value={l.band}>Near {l.name}</option>)}</select>
      <input type="search" id="f-q" placeholder="Resort or name" aria-label="Search by resort or name" />
    </div>
    <div class="riders" id="riders"></div>
    <p class="empty" id="riders-empty" hidden>Nobody listed yet. Join the crew and you give the next rider someone to find.</p>
  </section>

  <section data-pane="feed" hidden aria-label="Around the crew">
    <div class="card card--flush">
      <div class="card__head"><h2>Around the crew</h2><span class="meta">New riders, confirmed levels, landed tricks, camps</span></div>
      <ul class="rows" id="feed"></ul>
    </div>
  </section>

  <section data-pane="ride" hidden aria-label="Ride together">
    <div class="grid grid--main">
      <div class="stack">
        <div class="card card--flush">
          <div class="card__head"><h2>Who is riding where</h2><button class="btn btn--small" type="button" data-post>Post a ride</button></div>
          <ul class="rows" id="board"></ul>
        </div>
      </div>
      <div class="stack">
        <div class="card" id="requests-wrap" hidden><div class="card__head"><h2>Asking to ride with you</h2></div><ul class="rows" id="requests"></ul></div>
        <div class="card" id="contacts-wrap" hidden><div class="card__head"><h2>Riding together</h2></div><ul class="rows" id="contacts"></ul></div>
        <p class="small faint card card--quiet">Post where and when you ride. Riders ask to join; contact details are swapped only after you say yes.</p>
      </div>
    </div>
  </section>

  <section data-pane="highlights" hidden aria-label="Highlights">
    <div class="grid grid--2" id="highlights"></div>
  </section>
</App>

<style is:global>
  .optin { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between; }
  .riders { display: grid; gap: 10px; }
  @media (min-width: 640px) { .riders { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--gap); } }
  .rcard { display: flex; gap: 12px; align-items: flex-start; width: 100%; padding: 14px; text-align: left; font: inherit; color: inherit; cursor: pointer;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card); transition: border-color .15s; }
  .rcard:hover { border-color: var(--control); }
  .rcard__main { min-width: 0; flex: 1; display: grid; gap: 4px; }
  .rcard__main b { font-weight: 600; }
  .rcard .chip { align-self: start; }
  .wall { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .crewgrid { display: grid; gap: var(--gap); }
  @media (min-width: 960px) { .crewgrid { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); align-items: start; } }
  .faces { display: grid; grid-template-columns: repeat(auto-fill, minmax(68px, 1fr)); gap: 14px 8px; }
  .face { display: grid; justify-items: center; gap: 6px; padding: 0; font: inherit; font-size: 13px; color: inherit; background: none; border: 0; cursor: pointer; min-width: 0; }
  .face .avatar { width: 56px; height: 56px; font-size: 20px; transition: transform .12s; }
  .face:hover .avatar { transform: scale(1.04); }
  .face span:last-child { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .face--me .avatar { box-shadow: 0 0 0 2px var(--surface), 0 0 0 3.5px var(--accent); }
  .card__more { padding: 12px var(--pad); border-top: 1px solid var(--line); font-size: 14px; }
  .mecard { display: grid; gap: 14px; }
  .mecard__who { display: flex; gap: 12px; align-items: center; }
  .mecard__who b { display: block; font-weight: 600; }
  .asks { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; justify-content: space-between; margin-bottom: var(--gap); }
  .utabs a { cursor: pointer; }
  .utabs a[aria-selected='true'] { color: var(--text); font-weight: 600; }
  .utabs a[aria-selected='true']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--text); }
  .wall .photo > span { padding: 6px; }
  .toolbar input[type='search'] { min-height: 34px; padding-top: 5px; padding-bottom: 5px; font-size: 14px; }
</style>

<script>
  import { $, $$, esc, fmtDate, requireMe, sheet, toast } from '../members/ui';
  import { DISCIPLINE } from '../members/labels';
  import { levelName } from '../lib/members/rules';
  import { avatarHtml as av, levelPill as lvl, openRiderCard } from '../members/ridercard';
  import { sb } from '../members/sb';

  const me = await requireMe();
  await sb.rpc('ensure_my_rider');
  const [{ data: prof }, { data: mine }] = await Promise.all([
    sb.from('profiles').select('listed, ask_to_ride').eq('id', me.id).single(),
    sb.from('my_rider').select('id').maybeSingle(),
  ]);
  let listed = !!prof?.listed;
  const myRider = mine?.id as string | undefined;
  $('#optin').hidden = listed;
  const ago = (iso: string) => {
    const m = (Date.now() - new Date(iso).getTime()) / 6e4;
    if (m < 60) return 'now';
    if (m < 1440) return `${Math.floor(m / 60)} h`;
    if (m < 7 * 1440) return `${Math.floor(m / 1440)} d`;
    return fmtDate(iso, { day: 'numeric', month: 'short' });
  };

  // ------------------------------------------------ shared rows (the overview and the full tabs draw the same)
  type Post = Record<string, never>;
  const boardRow = (p: Post) => `<li class="row--wrap">
      <span class="daystub"><small>${esc(fmtDate(p.ride_date, { weekday: 'short' }))}</small><b>${esc(fmtDate(p.ride_date, { day: 'numeric' }))}</b></span>
      <span class="row__main"><b>${esc(p.place)}</b><span class="row__sub">${esc(p.name)}${p.band ? ` · ${esc(levelName(p.band))}` : ''}${p.note ? ` · ${esc(p.note)}` : ''}</span></span>
      <span class="row__end">${p.mine ? `<span class="small faint">Your post${p.pending_for_me ? ` · ${p.pending_for_me} asking` : ''}</span><button class="link small" data-del="${p.id}">Remove</button>`
        : p.my_request ? `<span class="pill${p.my_request === 'accepted' ? ' pill--pos' : ''}">${p.my_request === 'pending' ? 'Asked' : p.my_request === 'accepted' ? 'They said yes' : 'Not this time'}</span>`
        : p.can_ask ? `<button class="btn btn--small btn--ghost" data-ask="${p.id}">Ask to join</button>` : '<span class="small faint">Not taking requests</span>'}</span></li>`;
  const noRides = '<li class="small faint">No rides posted. Post where and when you ride, and riders at your level can join.</li>';

  type F = { kind: string; name: string; photo_url: string | null; created_at: string; payload: Record<string, string> };
  const feedLine = (f: F) => ({
    joined: `<b>${esc(f.name)}</b> joined the crew${f.payload.band ? ` at ${esc(levelName(Number(f.payload.band)))}` : ''}`,
    level: `<b>${esc(f.name)}</b> is now ${esc(levelName(Number(f.payload.band)))}, confirmed by a coach`,
    trick: `<b>${esc(f.name)}</b> landed a ${esc(f.payload.trick)}, signed off by a coach`,
    camp: `New camp: <b>${esc(f.payload.title)}</b> · ${esc(f.payload.place)} · <a href="/camps">apply</a>`,
    event: esc(f.payload.text ?? ''),
  } as Record<string, string>)[f.kind];
  const feedRow = (f: F) => `<li>${f.kind === 'camp' || f.kind === 'event' ? '<span class="avatar avatar--sm">B</span>' : av(f.photo_url, f.name)}
      <span class="row__main small"><span>${feedLine(f)}</span></span><span class="row__end meta">${esc(ago(f.created_at))}</span></li>`;
  const noFeed = '<li class="small faint">Nothing has happened yet. When someone joins or a coach confirms a level, it shows up here.</li>';

  // ------------------------------------------------ tabs
  const tabs = { home: loadHome, riders: loadRiders, feed: loadFeed, ride: loadRide, highlights: loadHighlights } as Record<string, () => Promise<void>>;
  let current = 'home';
  async function show(tab: string) {
    current = tab;
    for (const b of $$('[data-tab]')) b.setAttribute('aria-selected', String(b.dataset.tab === tab));
    for (const p of $$('[data-pane]')) p.hidden = p.dataset.pane !== tab;
    history.replaceState(null, '', tab === 'home' ? location.pathname : `#${tab}`);
    await tabs[tab]();
  }
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('[data-tab],[data-go]');
    if (!a) return;
    e.preventDefault();
    show(a.dataset.tab ?? a.dataset.go!);
    if (a.dataset.go) document.querySelector('.utabs')?.scrollIntoView({ block: 'nearest' });
  });

  // ------------------------------------------------ overview: people first, then what is happening
  async function loadHome() {
    const [{ data: people }, { data: board }, { data: feed }, { data: h }, { data: reqs }] = await Promise.all([
      sb.rpc('community_directory', { p_discipline: null, p_band: null, p_q: null }),
      sb.rpc('ride_board'), sb.rpc('community_feed'), sb.rpc('community_highlights'), sb.rpc('my_ride_requests'),
    ]);
    const ppl = (people ?? []) as Record<string, never>[];
    const meFirst = [...ppl.filter((r) => r.rider_id === myRider), ...ppl.filter((r) => r.rider_id !== myRider)];
    $('#ov-faces').innerHTML = meFirst.slice(0, 12).map((r) => `<button class="face${r.rider_id === myRider ? ' face--me' : ''}" type="button" data-card="${r.rider_id}">
      ${av(r.photo_url, r.name, '')}<span>${r.rider_id === myRider ? 'You' : esc(String(r.name).split(' ')[0])}</span></button>`).join('');
    $('#ov-faces-empty').hidden = ppl.length > 0;
    $('#ov-board').innerHTML = (board ?? []).slice(0, 3).map(boardRow).join('') || noRides;
    $('#ov-feed').innerHTML = ((feed ?? []) as F[]).slice(0, 5).map(feedRow).join('') || noFeed;
    $('#ov-figs').innerHTML = [[(h?.levels ?? []).length, 'levels confirmed'], [(h?.tricks ?? []).length, 'tricks landed'], [(h?.active ?? []).length, 'riders out riding']]
      .map(([n, l]) => `<div><b>${n}</b><span>${l}</span></div>`).join('');

    const pending = (reqs ?? []).filter((r: { status: string }) => r.status === 'pending');
    $('#ov-asks').hidden = !pending.length;
    $('#ov-asks').innerHTML = `<b>${pending.length} rider${pending.length === 1 ? ' is' : 's are'} asking to ride with you</b><a class="btn btn--small" href="#ride" data-go="ride">Answer</a>`;

    const meRow = ppl.find((r) => r.rider_id === myRider);
    $('#ov-me').innerHTML = `<div class="mecard__who">${av(me.photoUrl, me.firstName ?? me.email, '')}<div><b>${esc([me.firstName, me.lastName].filter(Boolean).join(' ') || me.email)}</b>
        <span class="small faint">${listed ? 'In the crew: riders can find you and ask to ride.' : 'Private: only your coach sees you.'}</span></div></div>
      ${listed && meRow?.band ? `<div class="actions">${lvl(meRow.band, meRow.verified)}</div>` : ''}
      <div class="actions"><button class="btn btn--small btn--ghost" type="button" data-mycard>See your card</button><a class="btn btn--small btn--ghost" href="/me/profile">Your profile</a></div>`;
  }

  // ------------------------------------------------ riders
  async function loadRiders() {
    const { data } = await sb.rpc('community_directory', { p_discipline: $<HTMLSelectElement>('#f-disc').value || null,
      p_band: Number($<HTMLSelectElement>('#f-band').value) || null, p_q: $<HTMLInputElement>('#f-q').value.trim() || null });
    $('#riders').innerHTML = (data ?? []).map((r: Record<string, never>) => `<button class="rcard" type="button" data-card="${r.rider_id}">
      ${av(r.photo_url, r.name, 'avatar--sm')}
      <span class="rcard__main"><b>${esc(r.name)}${r.rider_id === myRider ? ' <span class="small faint">(you)</span>' : ''}</b>
        <span class="small faint">${esc([(r.disciplines as string[]).map((d) => DISCIPLINE[d]).join(' + '), r.home_resort, r.riding_since && `since ${r.riding_since}`].filter(Boolean).join(' · '))}</span>
        ${r.favorite_trick ? `<span class="small">Favourite: ${esc(r.favorite_trick)}</span>` : ''}
        ${r.tricks_landed ? `<span class="meta">${r.tricks_landed} tricks landed</span>` : ''}</span>
      ${lvl(r.band, r.verified)}</button>`).join('');
    $('#riders-empty').hidden = (data ?? []).length > 0;
  }
  for (const id of ['#f-disc', '#f-band']) $(id).addEventListener('change', loadRiders);
  let qt = 0;
  $('#f-q').addEventListener('input', () => { clearTimeout(qt); qt = window.setTimeout(loadRiders, 300); });

  // ------------------------------------------------ feed
  async function loadFeed() {
    const { data } = await sb.rpc('community_feed');
    $('#feed').innerHTML = ((data ?? []) as F[]).map(feedRow).join('') || noFeed;
  }

  // ------------------------------------------------ ride together
  async function loadRide() {
    const [{ data: board }, { data: reqs }, { data: contacts }] = await Promise.all([sb.rpc('ride_board'), sb.rpc('my_ride_requests'), sb.rpc('my_ride_contacts')]);
    $('#board').innerHTML = (board ?? []).map(boardRow).join('') || noRides;
    const pending = (reqs ?? []).filter((r: { status: string }) => r.status === 'pending');
    $('#requests').innerHTML = pending.map((r: Record<string, never>) => `<li class="row--wrap"><span class="row__main"><b>${esc(r.name)}</b>
      <span class="row__sub">${r.band ? `${esc(levelName(r.band))} · ` : ''}${esc(r.place)}, ${esc(fmtDate(r.ride_date, { day: 'numeric', month: 'short' }))}${r.message ? ` · “${esc(r.message)}”` : ''}</span></span>
      <span class="row__end"><button class="btn btn--small" data-yes="${r.id}">Yes</button><button class="link small" data-no="${r.id}">No thanks</button></span></li>`).join('');
    $('#requests-wrap').hidden = !pending.length;
    $('#contacts').innerHTML = (contacts ?? []).map((c: Record<string, string>) => `<li><span class="row__main"><b>${esc(c.name)}</b>
      <span class="row__sub">${esc(c.place)} · ${esc(fmtDate(c.ride_date, { day: 'numeric', month: 'short' }))}</span>
      <span class="row__sub">${[c.phone, c.instagram && '@' + c.instagram, c.email].filter(Boolean).map(esc).join(' · ')}</span></span></li>`).join('');
    $('#contacts-wrap').hidden = !(contacts ?? []).length;
  }
  function openPost() {
    const sh = sheet('post', 'Post a ride');
    sh.body.innerHTML = `<form class="form" id="post-form">
      <div class="form__row form__row--2"><label class="field"><span>Where</span><input type="text" name="place" maxlength="80" placeholder="Livigno, Mottolino park" required /></label>
        <label class="field"><span>When</span><input type="date" name="date" required /></label></div>
      <label class="field"><span>Note</span><input type="text" name="note" maxlength="280" placeholder="Park laps from 10:00" /></label>
      ${listed ? '' : '<p class="small faint">Posting a ride puts you in the crew, so riders can see who posted.</p>'}
      <div class="actions"><button class="btn" type="submit">Post</button><button class="link" type="button" data-close>Cancel</button></div></form>`;
    sh.open();
    $<HTMLFormElement>('#post-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.currentTarget as HTMLFormElement);
      if (!listed) await joinCrew(false);
      const { data } = await sb.rpc('post_ride', { p_place: f.get('place'), p_date: f.get('date'), p_note: f.get('note') });
      toast(data === 'ok' ? 'Posted.' : data === 'not_listed' ? 'Join the crew first (top of the page).' : 'Pick today or later.', data === 'ok' ? 'ok' : 'bad');
      if (data === 'ok') sh.close();
      tabs[current]();
    });
  }

  // ------------------------------------------------ highlights
  async function loadHighlights() {
    const { data: h } = await sb.rpc('community_highlights');
    const block = (t: string, items: string[]) => items.length ? `<section class="card"><div class="card__head"><h2>${t}</h2></div><ul class="rows">${items.join('')}</ul></section>` : '';
    $('#highlights').innerHTML = (block('Levels confirmed this month', (h?.levels ?? []).map((x: Record<string, never>) => `<li><span class="row__main">${esc(x.name)}</span><span class="row__end">${lvl(x.band)}</span></li>`))
      + block('Tricks landed this month', (h?.tricks ?? []).map((x: Record<string, never>) => `<li><span class="row__main">${esc(x.name)}</span><span class="row__end small">${esc(x.trick)}</span></li>`))
      + block('Showing up this month', (h?.active ?? []).map((x: Record<string, never>) => `<li><span class="row__main">${esc(x.name)}</span><span class="row__end small num">${x.sessions} sessions</span></li>`)))
      || '<p class="empty" style="grid-column:1/-1">Once coaches start confirming levels and tricks, this fills up on its own. No ladders, no rankings.</p>';
  }

  // ------------------------------------------------ actions
  document.addEventListener('click', async (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-card],[data-ask],[data-yes],[data-no],[data-del],[data-post],[data-mycard]');
    if (!el) return;
    const d = el.dataset;
    if (d.card) {
      await openRiderCard(d.card, d.card === myRider ? { own: { listed } } : {});
    } else if (el.hasAttribute('data-mycard')) {
      if (myRider) await openRiderCard(myRider, { own: { listed } });
    } else if (el.hasAttribute('data-post')) {
      openPost();
    } else if (d.ask) {
      const sh = sheet('ask', 'Ask to ride along');
      sh.body.innerHTML = `<form class="form" id="ask-form"><label class="field"><span>A line for them (optional)</span><input type="text" name="message" maxlength="280" placeholder="Hi! I ride park, about your level." /></label>
        <p class="small faint">If they say yes, you both see each other's contact details.</p>
        <div class="actions"><button class="btn" type="submit">Send</button><button class="link" type="button" data-close>Cancel</button></div></form>`;
      sh.open();
      $<HTMLFormElement>('#ask-form').addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const message = String(new FormData(ev.currentTarget as HTMLFormElement).get('message') ?? '');
        const { data } = await sb.rpc('ask_to_ride', { p_post: d.ask, p_message: message });
        sh.close();
        toast(({ ok: 'Asked. If they say yes you both see each other’s contacts.', not_listed: 'Join the crew first, so they can see who is asking.', already: 'Already asked.', closed: 'They are not taking requests.' } as Record<string, string>)[data] ?? 'Could not ask.', data === 'ok' ? 'ok' : 'bad');
        tabs[current]();
      });
    } else if (d.yes || d.no) {
      await sb.rpc('respond_ride_request', { p_request: d.yes ?? d.no, p_accept: !!d.yes });
      tabs[current]();
    } else if (d.del) {
      await sb.rpc('delete_ride', { p_post: d.del });
      tabs[current]();
    }
  });

  async function joinCrew(say = true) {
    await sb.from('profiles').update({ listed: true, ask_to_ride: true }).eq('id', me.id);
    listed = true;
    $('#optin').hidden = true;
    if (say) toast('You are in the crew now.');
  }
  $('#go-listed').addEventListener('click', async () => { await joinCrew(); tabs[current](); });
  const start = location.hash.slice(1);
  await show(tabs[start] ? start : 'home');
</script>
