---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import Wear from '../components/Wear.astro';
import { Image, Picture, getImage } from 'astro:assets';
import '../styles/magazine.css';
import bib from '../assets/photos/ilia-bib-27.jpg';
import air from '../assets/photos/ilia-air.jpg';
import rail from '../assets/photos/ilia-rail.jpg';
import night from '../assets/photos/ilia-night.jpg';
import studio from '../assets/photos/ilia-studio.jpg';
import smile from '../assets/photos/ilia-smile.jpg';
import bandana from '../assets/photos/life-bandana.jpg';
import glacier from '../assets/photos/life-glacier.jpg';
import fisheye from '../assets/photos/life-fisheye.jpg';
import b1 from '../assets/boards/board-1-base.png';
import b2 from '../assets/boards/board-2-base.png';
import b3 from '../assets/boards/board-3-base.png';
import {
  rider, camp, brand, pages, pageIndex, nav, ui, hero, riderPage, coachPage, progress, train, life, nextCamp, nextLevel, seo,
} from '../content/site';

const photos = { air, rail, night, studio, smile, bandana, glacier, fisheye };
const boards = [b1, b2, b3];
// full-size versions for the photo viewer
const full = Object.fromEntries(await Promise.all(
  life.tiles.filter((t) => t.photo).map(async (t) => [t.photo!, (await getImage({ src: photos[t.photo!], width: 1280, format: 'webp' })).src]),
));
const P = (id: Parameters<typeof pageIndex>[0]) => pageIndex(id);

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Person', name: rider.name,
    jobTitle: 'Professional snowboarder and snowboard coach',
    url: new URL('/', site).href, sameAs: [rider.instagramUrl],
    award: ['3× National Champion', 'Europa Cup podiums'],
    knowsAbout: ['Snowboarding', 'Freestyle snowboarding', 'Snowboard coaching'],
  },
  {
    '@context': 'https://schema.org', '@type': 'Event', name: `${camp.full} — ${camp.kind}`,
    startDate: camp.startDate, endDate: camp.endDate,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'Place', name: `${camp.place}, ${camp.country}`, address: { '@type': 'PostalAddress', addressLocality: camp.place, addressCountry: 'IT' } },
    organizer: { '@type': 'Person', name: rider.name, url: rider.instagramUrl },
    performer: { '@type': 'Person', name: rider.name },
    maximumAttendeeCapacity: camp.spots,
    offers: { '@type': 'Offer', price: String(camp.priceValue), priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: new URL('/camp', site).href },
    description: camp.line, url: new URL('/camp', site).href,
  },
];

// hand-drawn marks (drawn on as each page lands)
const dblD = 'M1 10 C 25 3, 55 15, 99 5 M6 14 C 40 9, 70 13, 94 10';
const circleD = 'M52 6 C 90 4, 99 32, 97 56 C 95 90, 22 98, 7 70 C -3 42, 20 8, 60 10';
const starD = 'M30 2 L 35 22 L 56 14 L 40 30 L 58 44 L 36 40 L 30 58 L 24 40 L 2 46 L 20 30 L 4 14 L 25 22 Z';
const ext = { target: '_blank', rel: 'noopener' };
---
<Base title={seo.title} description={seo.description} path="/" jsonLd={jsonLd}>
<div class="mag" data-mag>
  <svg aria-hidden="true" width="0" height="0" style="position:absolute;width:0;height:0">
    <defs>
      <filter id="jit" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency=".035" numOctaves="2" seed="5" result="j" /><feDisplacementMap in="SourceGraphic" in2="j" scale="3.5" /></filter>
    </defs>
  </svg>

  <a class="skip" href="#main" data-skip>{ui.skip}</a>
  <div class="sr-only" aria-live="polite" data-live></div>

  <header class="masthead" data-chrome data-head="dark">
    <a class="masthead__brand" href="#cover" data-go="0">
      <!-- TODO(figma): swap for the BAS logo once the export is available -->
      <span class="logo-box" aria-hidden="true">{brand.logo}<b>★</b></span>
      <span class="sr-only">{brand.logoAlt}</span>
    </a>
    <span class="counter" aria-hidden="true" data-counter>01/{String(pages.length).padStart(2, '0')}</span>
    <nav class="masthead__nav" aria-label={nav.label}>
      {nav.links.map((l) => l.page
        ? <a href={`#${l.page}`} data-go={P(l.page as any)} data-nav={l.page}>{l.label}</a>
        : <a href={l.href} {...(l.external ? ext : {})}>{l.label}{l.external && <span aria-hidden="true"> ↗</span>}{l.external && <span class="sr-only"> {ui.newTab}</span>}</a>)}
    </nav>
    <a class="btn btn--red btn--sm masthead__cta" href="/camp"><span class="masthead__cta-l">{nav.cta}</span><span class="masthead__cta-s" aria-hidden="true">{nav.ctaShort}</span></a>
    <button class="btn-line masthead__menu" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>{ui.menu}</button>
  </header>

  <main id="main">
    <!-- ======================= 01 COVER ======================= -->
    <section class="page dark cover is-active" id="cover" data-page="0" data-tone="D" data-head="dark" aria-labelledby="h-cover">
      <div class="cover__photo">
        <Picture src={bib} alt={hero.photoAlt} formats={['avif', 'webp']} widths={[480, 854]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="cover__scrim" aria-hidden="true"></div>
      <div class="cover__inner scroller" data-scroll>
        <div class="cover__head">
          <p class="cover__kicker">{hero.kicker}</p>
          <h1 class="cover__h1" id="h-cover" tabindex="-1"><span class="cover__first">{hero.h1[0]}</span> <span class="cover__last">{hero.h1[1]}</span></h1>
        </div>
        <p class="cover__spin">
          <span class="cover__spin-l">{hero.spin.label}</span>
          <span class="cover__spin-v">{hero.spin.value}<svg class="mk" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none" style="inset:-4% -12% -18%;width:124%;height:122%" fill="none" stroke="#FF94E3" stroke-width="3" stroke-linecap="round"><path data-draw vector-effect="non-scaling-stroke" d={circleD} /></svg></span>
        </p>
        <div class="cover__foot">
          <p class="cover__claim"><span>{hero.claim}<svg class="mk" aria-hidden="true" viewBox="0 0 100 16" preserveAspectRatio="none" style="left:0;bottom:-.1em;width:100%;height:.16em" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d={dblD} stroke="#BA1422" stroke-width="5" /></svg></span></p>
          <p class="cover__sub">{hero.sub}</p>
          <ul class="cover__proof" role="list">{hero.proof.map((p) => <li>{p}</li>)}</ul>
          <div class="cover__ctas">
            <a class="btn btn--red" href="/camp">{hero.ctaCamp}</a>
            <a class="btn btn--ghost" href="#train" data-go={P('train')}>{hero.ctaCoaching}</a>
          </div>
        </div>
        <p class="cover__hint" aria-hidden="true"><span class="cover__hint-m">{hero.hint}</span><span class="cover__hint-d">{hero.hintDesktop}</span><i></i></p>
      </div>
      <Wear tone="D" />
    </section>

    <!-- ======================= 02 THE RIDER ======================= -->
    <section class="page paper rider" id="ilia" data-page="1" data-tone="L" data-head="light" aria-labelledby="h-ilia">
      <div class="staple" style="top:28%" aria-hidden="true"></div>
      <div class="staple" style="top:72%" aria-hidden="true"></div>
      <div class="scroller" data-scroll>
        <div class="pg rider__grid">
          <header class="pg__head rider__head">
            <p class="kicker"><span class="kicker__n">02</span>{riderPage.kicker}</p>
            <h2 class="h2" id="h-ilia" tabindex="-1">{riderPage.h2[0]}<br /><span class="u">{riderPage.h2[1]}<svg class="mk" aria-hidden="true" viewBox="0 0 100 16" preserveAspectRatio="none" style="left:0;bottom:-.06em;width:100%;height:.14em" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d={dblD} stroke="#BA1422" stroke-width="4" /></svg></span></h2>
            <dl class="rider__details">
              {riderPage.details.map((d) => <div><dt>{d.label}</dt><dd>{d.value}</dd></div>)}
            </dl>
          </header>
          <div class="car car--rider" data-carousel role="region" aria-roledescription="carousel" aria-label={riderPage.carousel}>
            <div class="car__viewport" data-car-viewport>
              <ol class="car__track" data-car-track role="list">
                {riderPage.slides.map((s, i) => (
                  <li class:list={['slide', 'rs', `rs--${s.kind}`]} data-slide aria-roledescription="slide" aria-label={ui.slide(i + 1, riderPage.slides.length)}>
                    <div class="rs__media">
                      {s.kind === 'photo' && <Image src={photos[s.photo!]} alt={s.alt ?? ''} widths={[400, 800]} sizes="(min-width: 900px) 26vw, 80vw" format="webp" loading="lazy" style={`object-position:${s.pos ?? '50% 50%'}`} draggable="false" />}
                      {s.kind === 'number' && <span class="rs__giant" aria-hidden="true">{s.big}</span>}
                      {s.kind === 'boards' && (
                        <div class="rs__boards" role="img" aria-label={riderPage.boardsAlt}>
                          {boards.map((b) => <Image src={b} alt="" widths={[90, 180]} sizes="(min-width: 900px) 4vw, 14vw" format="webp" loading="lazy" draggable="false" />)}
                        </div>
                      )}
                    </div>
                    <p class="rs__stat">
                      {s.kind === 'number'
                        ? <span class="sr-only">{s.big} </span>
                        : <span class:list={['rs__big', { 'rs__big--words': s.big.length > 5 }]}>{s.big}</span>}
                      <span class="rs__label">{s.label}</span>
                      {s.sub && <span class="rs__sub">{s.sub}</span>}
                    </p>
                  </li>
                ))}
              </ol>
            </div>
            <div class="car__bar">
              <span class="car__note marker" data-ink aria-hidden="true">{riderPage.note}</span>
              <div class="car__ctrl">
                <button class="car__btn" type="button" data-car-prev aria-label={ui.prev}>←</button>
                <span class="car__count" data-car-count aria-hidden="true">01/06</span>
                <button class="car__btn" type="button" data-car-next aria-label={ui.next}>→</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <Wear tone="L" />
    </section>

    <!-- ======================= 03 FROM RIDER TO COACH ======================= -->
    <section class="page dark coach" id="coaching" data-page="2" data-tone="D" data-head="dark" aria-labelledby="h-coaching">
      <div class="scroller" data-scroll>
        <div class="pg coach__grid">
          <header class="pg__head coach__head">
            <p class="kicker"><span class="kicker__n">03</span>{coachPage.kicker}</p>
            <h2 class="h2 coach__h2" id="h-coaching" tabindex="-1">
              {coachPage.h2.map(([n, rest]) => <span class="coach__line"><em>{n}</em> {rest}</span>)}
            </h2>
            <p class="coach__lead"><strong>{coachPage.lead}</strong> {coachPage.leadMore}</p>
          </header>
          <div class="loop">
            <p class="loop__label">{coachPage.loopLabel}</p>
            <ol class="loop__steps" role="list">
              {coachPage.loop.map((s, i) => (
                <li class="loop__step"><span class="loop__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="loop__w">{s.word}</span><span class="loop__l">{s.line}</span></li>
              ))}
            </ol>
            <svg class="mk loop__back" aria-hidden="true" viewBox="0 0 100 40" preserveAspectRatio="none" fill="none" stroke="#FF94E3" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d="M96 6 C 99 30, 70 38, 50 37 C 28 36, 4 32, 3 10 M-1 17 L 3 9 L 9 16" /></svg>
            <span class="loop__note marker" data-ink aria-hidden="true">{coachPage.loopNote}</span>
          </div>
          <ul class="tags coach__tags" role="list">{coachPage.support.map((t) => <li>{t}</li>)}</ul>
          <figure class="coach__media">
            <!-- TODO(coachingMedia): a coaching photo or clip replaces this placeholder -->
            <div class="ph ph--dark" aria-hidden="true"><span class="ph__top"><span class="ph__rec">REC</span><span>{coachPage.media.label}</span></span><span class="ph__play"></span><span class="ph__cap">{coachPage.media.cap}</span></div>
          </figure>
        </div>
      </div>
      <Wear tone="D" />
    </section>

    <!-- ======================= 04 STUDENT PROGRESS ======================= -->
    <section class="page paper progress" id="progress" data-page="3" data-tone="L" data-head="light" aria-labelledby="h-progress">
      <div class="staple" style="top:28%" aria-hidden="true"></div>
      <div class="staple" style="top:72%" aria-hidden="true"></div>
      <div class="scroller" data-scroll>
        <div class="pg progress__grid">
          <header class="pg__head progress__head">
            <p class="kicker"><span class="kicker__n">04</span>{progress.kicker}</p>
            <h2 class="h2 progress__h2" id="h-progress" tabindex="-1"><span class="progress__pre">{progress.h2[0]}</span> <span class="progress__main">{progress.h2[1]}</span></h2>
          </header>
          <div class="car car--cases" data-carousel role="region" aria-roledescription="carousel" aria-label={progress.carousel}>
            <div class="car__viewport" data-car-viewport>
              <ol class="car__track" data-car-track role="list">
                {progress.cases.map((c, i) => (
                  <li class="slide case" data-slide data-case aria-roledescription="slide" aria-label={ui.slide(i + 1, progress.cases.length)}>
                    <figure class="case__media">
                      {/* TODO(studentCases): set video.src (vertical clip) and video.poster in site.ts */}
                      {c.video?.poster && <img class="case__poster" src={c.video.poster} alt="" loading="lazy" />}
                      {!c.video?.src && !c.video?.poster && (
                        <div class="ph ph--light" aria-hidden="true"><span class="ph__top"><span class="ph__rec">REC</span><span>{progress.labels.video} {c.n}</span></span><span class="ph__play"></span><span class="ph__cap">[Vertical video]</span></div>
                      )}
                      {c.video?.src && <video muted loop playsinline preload="none" poster={c.video.poster} src={c.video.src}></video>}
                      {c.video?.src && <button class="case__play" type="button" data-case-play aria-pressed="false" aria-label={progress.labels.play(c.n)} data-play={progress.labels.play(c.n)} data-pause={progress.labels.pause(c.n)}><span aria-hidden="true"></span></button>}
                    </figure>
                    <div class="case__body">
                      <p class="case__n">Rider {c.n}</p>
                      <h3 class="case__rider">{c.rider}</h3>
                      <p class="case__tag">{c.tag}</p>
                      <ol class="case__steps" role="list">
                        <li><span class="case__k">{progress.labels.start}</span><span class="case__v">{c.start}</span></li>
                        <li><span class="case__k">{progress.labels.work}</span><span class="case__v">{c.work}</span></li>
                        <li class="case__res"><span class="case__k">{progress.labels.result}</span><span class="case__v">{c.result}</span></li>
                      </ol>
                      {c.quote && <blockquote class="case__quote">“{c.quote}”</blockquote>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
            <div class="car__bar">
              <span></span>
              <div class="car__ctrl">
                <button class="car__btn" type="button" data-car-prev aria-label={ui.prev}>←</button>
                <span class="car__count" data-car-count aria-hidden="true">01/03</span>
                <button class="car__btn" type="button" data-car-next aria-label={ui.next}>→</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <Wear tone="L" />
    </section>

    <!-- ======================= 05 WAYS TO TRAIN ======================= -->
    <section class="page dark train" id="train" data-page="4" data-tone="D" data-head="dark" aria-labelledby="h-train">
      <div class="scroller" data-scroll>
        <div class="pg train__grid">
          <header class="pg__head train__head">
            <p class="kicker"><span class="kicker__n">05</span>{train.kicker}</p>
            <h2 class="h2" id="h-train" tabindex="-1">{train.h2[0]} {train.h2[1]}</h2>
          </header>
          <div class="options">
            <article class="opt" aria-labelledby="h-opt-a">
              <div class="opt__media"><Image src={rail} alt={train.coaching.alt} widths={[480, 960]} sizes="(min-width: 900px) 40vw, 100vw" format="webp" loading="lazy" style="object-position:50% 35%" /></div>
              <div class="opt__body">
                <p class="opt__label"><span>{train.coaching.label}</span></p>
                <h3 class="opt__title" id="h-opt-a">{train.coaching.title}</h3>
                <p class="opt__price"><span class="opt__from">{train.coaching.from}</span> <strong>{train.coaching.price}</strong> <span class="opt__per">{train.coaching.per}</span></p>
                <p class="opt__text">{train.coaching.body}</p>
                <ul class="tags tags--sm" role="list">{train.coaching.areas.map((a) => <li>{a}</li>)}</ul>
                <div class="opt__cta">
                  <a class="btn btn--red" href={rider.dmUrl} {...ext}>{train.coaching.cta} <span aria-hidden="true">↗</span><span class="sr-only"> {ui.newTab}</span></a>
                  <p class="opt__note">{train.coaching.note}</p>
                </div>
              </div>
            </article>
            <article class="opt opt--camp" aria-labelledby="h-opt-b">
              <div class="opt__media"><Image src={glacier} alt={train.camp.alt} widths={[480, 960]} sizes="(min-width: 900px) 40vw, 100vw" format="webp" loading="lazy" style="object-position:50% 40%" /></div>
              <div class="opt__body">
                <p class="opt__label"><span>{train.camp.label}</span></p>
                <h3 class="opt__title" id="h-opt-b">{train.camp.title}</h3>
                <p class="opt__lines">{train.camp.lines.map((l) => <span>{l}</span>)}</p>
                <dl class="opt__facts">
                  <div><dt>{train.camp.next}</dt><dd>{train.camp.when} · {train.camp.where}</dd></div>
                  <div><dt class="sr-only">Disciplines</dt><dd>{train.camp.disciplines}</dd></div>
                </dl>
                <div class="opt__cta">
                  <a class="btn btn--dark" href="/camp">{train.camp.cta} <span aria-hidden="true">→</span></a>
                  <p class="opt__price opt__price--inline"><strong>{train.camp.price}</strong></p>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
      <Wear tone="D" />
    </section>

    <!-- ======================= 06 BAS LIFE ======================= -->
    <section class="page paper life" id="life" data-page="5" data-tone="L" data-head="light" aria-labelledby="h-life">
      <div class="staple" style="top:28%" aria-hidden="true"></div>
      <div class="staple" style="top:72%" aria-hidden="true"></div>
      <div class="scroller" data-scroll>
        <div class="pg life__grid">
          <header class="pg__head life__head">
            <p class="kicker"><span class="kicker__n">06</span>{life.kicker}</p>
            <h2 class="h2" id="h-life" tabindex="-1">{life.h2[0]} <br /><span class="red-t">{life.h2[1]}</span></h2>
          </header>
          <div class="car car--life" data-carousel role="region" aria-roledescription="carousel" aria-label={life.carousel}>
            <div class="car__viewport" data-car-viewport>
              <ol class="car__track" data-car-track role="list">
                {life.tiles.map((t, i) => (
                  <li class:list={['slide', 'print', `print--${t.shape}`, { 'print--todo': t.todo }]} data-slide aria-roledescription="slide" aria-label={ui.slide(i + 1, life.tiles.length)}>
                    {t.photo ? (
                      <button class="print__img" type="button" data-tile data-full={full[t.photo]} data-cap={t.cap} data-alt={t.alt} aria-label={life.open(t.cap)}>
                        <Image src={photos[t.photo]} alt={t.alt ?? ''} widths={[360, 720]} sizes="(min-width: 900px) 24vw, 62vw" format="webp" loading="lazy" style={`object-position:${t.pos ?? '50% 50%'}`} draggable="false" />
                      </button>
                    ) : (
                      // TODO(lifeMedia): a real photo replaces this placeholder
                      <div class="print__img print__ph"><span>{t.cap}</span></div>
                    )}
                    {!t.todo && <p class="print__cap">{t.cap}</p>}
                  </li>
                ))}
              </ol>
            </div>
            <div class="car__bar">
              <span class="car__note marker" data-ink aria-hidden="true">{life.note}</span>
              <div class="car__ctrl">
                <button class="car__btn" type="button" data-car-prev aria-label={ui.prev}>←</button>
                <span class="car__count" data-car-count aria-hidden="true">01/06</span>
                <button class="car__btn" type="button" data-car-next aria-label={ui.next}>→</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <Wear tone="L" />
    </section>

    <!-- ======================= 07 NEXT CAMP ======================= -->
    <section class="page signal nextcamp" id="next-camp" data-page="6" data-tone="L" data-head="red" aria-labelledby="h-next-camp">
      <div class="nextcamp__photo" aria-hidden="true">
        <Image src={glacier} alt="" widths={[480, 960]} sizes="(min-width: 900px) 50vw, 100vw" format="webp" loading="lazy" />
      </div>
      <div class="nextcamp__inner scroller" data-scroll>
        <div class="nextcamp__top">
          <span class="logo-box logo-box--lg" aria-hidden="true">BAS<b>★</b>CAMP</span>
          <span class="nextcamp__issue">{nextCamp.issue}</span>
        </div>
        <div class="nextcamp__main">
          <p class="kicker kicker--ice">{nextCamp.kicker}</p>
          <h2 class="nextcamp__place" id="h-next-camp" tabindex="-1"><span class="sr-only">{camp.name} {camp.issue}: </span>{nextCamp.place}</h2>
          <p class="nextcamp__dates"><span>{nextCamp.dates[0]}</span> <span>{nextCamp.dates[1]}</span><svg class="mk" aria-hidden="true" viewBox="0 0 100 16" preserveAspectRatio="none" style="left:0;bottom:-.14em;width:100%;height:.2em" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d={dblD} stroke="#E1EFFA" stroke-width="4" /></svg></p>
          <ul class="nextcamp__facts" role="list">{nextCamp.facts.map((f) => <li>{f}</li>)}</ul>
          <p class="nextcamp__line">{nextCamp.line}</p>
          <a class="btn btn--ice btn--lg" href="/camp">{nextCamp.cta} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <Wear tone="L" />
    </section>

    <!-- ======================= 08 YOUR NEXT LEVEL ======================= -->
    <section class="page dark final" id="next-level" data-page="7" data-tone="D" data-head="dark" aria-labelledby="h-next-level">
      <div class="final__photo" aria-hidden="true">
        <Image src={studio} alt="" widths={[480, 853]} sizes="(min-width: 900px) 40vw, 90vw" format="webp" loading="lazy" />
      </div>
      <div class="final__inner scroller" data-scroll>
        <h2 class="final__h2" id="h-next-level" tabindex="-1">{nextLevel.h2[0]}<br /><span class="u">{nextLevel.h2[1]}<svg class="mk" aria-hidden="true" viewBox="0 0 60 60" style="right:-.55em;top:-.1em;width:.42em;height:.42em" fill="none" stroke="#FF94E3" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path data-draw d={starD} /></svg></span></h2>
        <div class="paths">
          {nextLevel.paths.map((p) => (
            <a class:list={['path', `path--${p.kind}`]} href={p.kind === 'camp' ? '/camp' : rider.dmUrl} {...(p.kind === 'camp' ? {} : ext)}>
              <span class="path__label">{p.label}</span>
              <span class="path__sub">{p.sub}</span>
              <span class="path__cta">{p.cta} <span aria-hidden="true">{p.kind === 'camp' ? '→' : '↗'}</span></span>
              {p.kind !== 'camp' && <span class="sr-only"> {ui.newTab}</span>}
            </a>
          ))}
        </div>
        <p class="final__ig"><span class="final__ig-l">{nextLevel.social}</span> <a href={rider.instagramUrl} {...ext}>@{rider.instagram} <span aria-hidden="true">↗</span></a></p>
        <footer class="final__foot">
          <span class="logo-box" aria-hidden="true">{brand.logo}<b>★</b></span>
          <span>{nextLevel.footer.issue}</span>
          <span>{nextLevel.footer.copyright}</span>
          <a class="btn-line totop" href="#cover" data-go="0">{nextLevel.footer.toTop}</a>
        </footer>
      </div>
      <Wear tone="D" />
    </section>
  </main>

  <Stage />
  <canvas class="paper-canvas" aria-hidden="true" data-paper-canvas></canvas>

  <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label={ui.contents} hidden data-menu>
    <div class="menu__head">
      <span class="menu__kicker">{ui.contents}</span>
      <button class="btn-line" type="button" data-menu-close>{ui.close}</button>
    </div>
    <nav aria-label={ui.pagesNav}>
      <ol>
        {pages.map((p, i) => (
          <li><a class="menu__item" href={`#${p.id}`} data-go={i} aria-current={i === 0 ? 'page' : undefined}><span class="menu__num">{p.num}</span><span class="menu__title">{p.title}</span></a></li>
        ))}
      </ol>
    </nav>
    <div class="menu__foot">
      <a class="btn btn--red" href="/camp">{nav.cta}</a>
      <a class="menu__ig" href={rider.instagramUrl} {...ext}>Instagram @{rider.instagram} <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <div class="lightbox" role="dialog" aria-modal="true" aria-label={life.viewer} hidden data-lightbox>
    <button class="btn-line lightbox__close" type="button" data-lb-close aria-label={life.closeViewer}>{ui.close}</button>
    <div class="lightbox__stage" data-lb-stage></div>
    <div class="lightbox__bar">
      <button class="btn-line" type="button" data-lb-prev aria-label={ui.prev}>←</button>
      <p class="lightbox__cap" data-lb-cap aria-live="polite"></p>
      <button class="btn-line" type="button" data-lb-next aria-label={ui.next}>→</button>
    </div>
  </div>
</div>

<script>
  import '../scripts/magazine';
</script>
</Base>
