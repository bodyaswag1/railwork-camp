---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import Wear from '../components/Wear.astro';
import Splat from '../components/Splat.astro';
import { Image, Picture, getImage } from 'astro:assets';
import '../styles/punk.css';
import '../styles/magazine.css';
import bib from '../assets/photos/ilia-bib-27.jpg';
import air from '../assets/photos/ilia-air.jpg';
import rail from '../assets/photos/ilia-rail.jpg';
import night from '../assets/photos/ilia-night.jpg';
import studio from '../assets/photos/ilia-studio.jpg';
import smile from '../assets/photos/ilia-smile.jpg';
import boardslide from '../assets/photos/ilia-boardslide.jpg';
import jump from '../assets/photos/ilia-jump.jpg';
import t9563 from '../assets/clips/trick-9563.jpg';
import t2644 from '../assets/clips/trick-2644.jpg';
import t0123 from '../assets/clips/trick-0123.jpg';
import t6120 from '../assets/clips/trick-6120.jpg';
import bandana from '../assets/photos/life-bandana.jpg';
import glacier from '../assets/photos/life-glacier.jpg';
import fisheye from '../assets/photos/life-fisheye.jpg';
import b1t from '../assets/boards/board-1-top.png';
import b1b from '../assets/boards/board-1-base.png';
import b2t from '../assets/boards/board-2-top.png';
import b2b from '../assets/boards/board-2-base.png';
import b3t from '../assets/boards/board-3-top.png';
import b3b from '../assets/boards/board-3-base.png';
import {
  rider, camp, brand, pages, pageIndex, nav, ui, hero, riderPage, coachPage, progress, train, nextCamp, nextLevel, seo,
} from '../content/site';

const photos = { air, rail, night, studio, smile, bandana, glacier, fisheye, bib, boardslide };
const clipPosters = { 'trick-9563': t9563, 'trick-2644': t2644, 'trick-0123': t0123, 'trick-6120': t6120 };
const boardImgs: Record<string, ImageMetadata> = {
  'board-1-top': b1t, 'board-1-base': b1b, 'board-2-top': b2t,
  'board-2-base': b2b, 'board-3-top': b3t, 'board-3-base': b3b,
};
// boards are height-driven (see .board__drop): width = height × 205/1112
const boardSizes = '(max-width: 899px) calc(min(34svh, 60vw) * 0.184), calc(min(60svh, max(36svh, 42vw)) * 0.184)';
// full-size versions for the photo viewer
const P = (id: Parameters<typeof pageIndex>[0]) => pageIndex(id);

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Person', name: rider.name,
    jobTitle: 'Professional snowboarder and snowboard coach',
    url: new URL('/', site).href, sameAs: [rider.instagramUrl],
    award: ['3× National Champion', 'Europa Cup podiums'],
    knowsAbout: ['Snowboarding', 'Freestyle snowboarding', 'Snowboard coaching'],
  },
  {
    '@context': 'https://schema.org', '@type': 'Event', name: `${camp.full} — ${camp.kind}`,
    startDate: camp.startDate, endDate: camp.endDate,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'Place', name: `${camp.place}, ${camp.country}`, address: { '@type': 'PostalAddress', addressLocality: camp.place, addressCountry: 'IT' } },
    organizer: { '@type': 'Person', name: rider.name, url: rider.instagramUrl, email: rider.email, telephone: rider.phoneHref.slice(4) },
    performer: { '@type': 'Person', name: rider.name },
    maximumAttendeeCapacity: camp.spots,
    offers: { '@type': 'Offer', price: String(camp.priceValue), priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: new URL('/camp', site).href },
    description: camp.line, url: new URL('/camp', site).href,
  },
];

// hand-drawn marks (drawn on as each page lands)
const dblD = 'M1 10 C 25 3, 55 15, 99 5 M6 14 C 40 9, 70 13, 94 10';
const circleD = 'M52 6 C 90 4, 99 32, 97 56 C 95 90, 22 98, 7 70 C -3 42, 20 8, 60 10';
const starD = 'M30 2 L 35 22 L 56 14 L 40 30 L 58 44 L 36 40 L 30 58 L 24 40 L 2 46 L 20 30 L 4 14 L 25 22 Z';
const boxD = 'M2 5 L 98 2 L 97 97 L 3 95 Z M5 1 L 99 7 L 95 99 L 1 93 L 4 3';
const burstD = 'M50 4 L 57 32 L 84 14 L 68 41 L 97 48 L 69 58 L 87 86 L 57 70 L 50 97 L 43 70 L 13 86 L 31 58 L 3 48 L 32 41 L 16 14 L 43 32 Z';
const xD = 'M4 6 L 24 30 M24 4 L 6 32 M34 10 L 54 34 M52 8 L 36 36';
const zigD = 'M2 2 L 18 10 L 2 18 L 18 26 L 2 34';
const curveD = 'M6 44 C 20 14, 46 6, 70 12 M58 4 L 72 12 L 60 24';
const downD = 'M20 2 C 8 20, 32 36, 18 62 M7 50 L 18 64 L 30 51';
const ext = { target: '_blank', rel: 'noopener' };
---
<Base title={seo.title} description={seo.description} path="/" jsonLd={jsonLd}>
<div class="mag" data-mag>
  <svg aria-hidden="true" width="0" height="0" style="position:absolute;width:0;height:0">
    <defs>
      <filter id="jit" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency=".035" numOctaves="2" seed="5" result="j" /><feDisplacementMap in="SourceGraphic" in2="j" scale="3.5" /></filter>
    </defs>
  </svg>

  <a class="skip" href="#main" data-skip>{ui.skip}</a>
  <div class="sr-only" aria-live="polite" data-live></div>

  <header class="masthead" data-chrome data-head="dark">
    <a class="masthead__brand" href="#cover" data-go="0">
      <!-- TODO(figma): swap for the BAS logo once the export is available -->
      <span class="logo-box" aria-hidden="true">{brand.logo}<b>★</b></span>
      <span class="sr-only">{brand.logoAlt}</span>
    </a>
    <span class="counter" aria-hidden="true" data-counter>01/{String(pages.length).padStart(2, '0')}</span>
    <nav class="masthead__nav" aria-label={nav.label}>
      {nav.links.map((l) => l.page
        ? <a href={`#${l.page}`} data-go={P(l.page as any)} data-nav={l.page}>{l.label}</a>
        : <a href={l.href} {...(l.external ? ext : {})}>{l.label}{l.external && <span aria-hidden="true"> ↗</span>}{l.external && <span class="sr-only"> {ui.newTab}</span>}</a>)}
    </nav>
    <a class="btn btn--red btn--sm masthead__cta" href="/camp"><span class="masthead__cta-l">{nav.cta}</span><span class="masthead__cta-s" aria-hidden="true">{nav.ctaShort}</span></a>
    <button class="btn-line masthead__menu" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>{ui.menu}</button>
  </header>

  <main id="main">
    <!-- ======================= 01 COVER ======================= -->
    <section class="page dark cover is-active" id="cover" data-page="0" data-tone="D" data-head="dark" aria-labelledby="h-cover">
      <div class="cover__photo">
        <Picture src={studio} alt={hero.photoAlt} formats={['avif', 'webp']} widths={[480, 854]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="cover__scrim" aria-hidden="true"></div>
      <div class="cover__inner scroller" data-scroll>
        <div class="decor" aria-hidden="true">
          <span class="crop crop--tl"></span><span class="crop crop--tr"></span>
          <span class="vtext cover__vt">Issue 01 · Winter 26/27 · BAS · Ride / learn / repeat</span>
          <Splat class="cover__splat" stamp="0.9" />
          <span class="scrawl marker cover__note hide-m" data-ink>the coach</span>
          <svg class="mk cover__arrow hide-m" viewBox="0 0 80 50" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw d={curveD} stroke="#FF94E3" stroke-width="3" /></svg>
          <svg class="mk cover__x" viewBox="0 0 60 40" fill="none" stroke-linecap="round"><path data-draw d={xD} stroke="#BA1422" stroke-width="3.5" /></svg>
          <span class="barcode cover__bar hide-m"><i></i><span>4 607162 001620</span></span>
        </div>
        <div class="cover__head">
          <span class="stamp stamp--pink cover__stamp" data-stamp="0.75" aria-hidden="true">No. 01 · Winter 26/27</span>
          <p class="cover__kicker">{hero.kicker}</p>
          <h1 class="cover__h1" id="h-cover" tabindex="-1"><span class="cover__first">{hero.h1[0]}</span> <span class="cover__last">{hero.h1[1]}</span></h1>
        </div>
        <div class="cover__foot">
          <p class="cover__claim"><span>{hero.claim}<svg class="mk" aria-hidden="true" viewBox="0 0 100 16" preserveAspectRatio="none" style="left:0;bottom:-.1em;width:100%;height:.16em" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d={dblD} stroke="#BA1422" stroke-width="5" /></svg><svg class="mk" aria-hidden="true" viewBox="0 0 100 100" style="right:-.42em;top:-.22em;width:.4em;height:.4em" fill="none" stroke="#FF94E3" stroke-width="5" stroke-linejoin="round"><path data-draw d={burstD} /></svg></span></p>
          <p class="cover__sub">{hero.sub}</p>
          <ul class="cover__proof" role="list">{hero.proof.map((p) => <li>{p}</li>)}</ul>
          <div class="cover__ctas">
            <a class="btn btn--red" href="/camp">{hero.ctaCamp}</a>
            <a class="btn btn--ghost" href="#train" data-go={P('train')}>{hero.ctaCoaching}</a>
          </div>
        </div>
        <p class="cover__hint" aria-hidden="true"><span class="cover__hint-m">{hero.hint}</span><span class="cover__hint-d">{hero.hintDesktop}</span><i></i></p>
      </div>
      <Wear tone="D" />
    </section>

    <!-- ======================= 02 THE RIDER ======================= -->
    <section class="page paper stats" id="ilia" data-page="1" data-tone="L" data-head="light" aria-labelledby="h-ilia">
      <div class="staple" style="top:28%" aria-hidden="true"></div>
      <div class="staple" style="top:72%" aria-hidden="true"></div>
      <div class="scroller" data-scroll>
        <div class="stats__wrap">
          <span class="crop crop--tl" aria-hidden="true"></span><span class="crop crop--br" aria-hidden="true"></span>
          <div class="stats__left">
            <div class="stats__head">
              <div class="pics" data-carousel data-pile role="region" aria-roledescription="carousel" aria-label={riderPage.pics.label} tabindex="0">
                <div class="pics__stack">
                  <svg class="mk" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none" style="left:-12px;top:-12px;width:calc(100% + 24px);height:calc(100% + 24px);z-index:20" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d={boxD} stroke="#BA1422" stroke-width="3" /></svg>
                  {riderPage.pics.slides.map((p, i) => (
                    <figure class:list={['pic', `pic--${p.kind}`]} data-slide aria-roledescription="slide" aria-label={ui.slide(i + 1, riderPage.pics.slides.length)}>
                      <span class="tape tape--pic" aria-hidden="true"></span>
                      {p.kind === 'photo' && <Image src={photos[p.photo!]} alt={p.alt} widths={[300, 600]} sizes="(min-width: 900px) 20vw, 44vw" format="webp" loading={i < 3 ? 'eager' : 'lazy'} style={`object-position:${p.pos ?? '50% 50%'}`} draggable="false" />}
                      {p.kind === 'gif' && <Image src={clipPosters[p.poster!]} alt={p.alt} widths={[300, 600]} sizes="(min-width: 900px) 20vw, 44vw" format="webp" loading={i < 3 ? 'eager' : 'lazy'} draggable="false" />}
                      {/* the GIF itself: src set by pile.ts when this print comes up; never in the paper's copies */}
                      {p.kind === 'gif' && <img class="pic__gif" data-gif={p.gif} data-nocopy alt="" aria-hidden="true" loading="lazy" decoding="async" draggable="false" />}
                      <figcaption class="pic__cap" aria-hidden="true">{p.cap}</figcaption>
                    </figure>
                  ))}
                </div>
                <span class="pics__count" data-car-count aria-hidden="true">01/{String(riderPage.pics.slides.length).padStart(2, '0')}</span>
                <span class="pics__note marker" data-ink aria-hidden="true">{riderPage.pics.note}</span>
              </div>
              <div class="stats__title">
                <p class="kicker"><span class="kicker__n">02</span>{riderPage.kicker}</p>
                <svg class="mk stats__arrow" aria-hidden="true" viewBox="0 0 80 50" style="right:4%;top:-30px;width:64px;height:44px" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw d="M6 44 C 20 14, 46 6, 70 12 M58 4 L 72 12 L 60 24" stroke="#BA1422" stroke-width="3" /></svg>
                <span class="stats__legend marker" data-ink aria-hidden="true">{riderPage.note}</span>
                <h2 class="stats__h2" id="h-ilia" tabindex="-1">{riderPage.h2[0]}<br />{riderPage.h2[1]}<span class="sr-only"> — {riderPage.sub}</span></h2>
                <div class="rule5" aria-hidden="true"></div>
                <div class="stats__sub" aria-hidden="true">{riderPage.sub}</div>
                <p class="stats__meta">{riderPage.meta}</p>
              </div>
            </div>
            <ul class="badges" role="list">
              <li class="badge badge--champ">
                <span class="b-big">{riderPage.badges.champ.big}</span>
                <span class="b-wide">{riderPage.badges.champ.small[0]} {riderPage.badges.champ.small[1]}</span>
                <svg class="mk" aria-hidden="true" viewBox="0 0 40 30" style="right:6%;top:-10%;width:clamp(26px,2.8vw,42px)" fill="none" stroke="#BA1422" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path data-draw d="M4 26 L 6 6 L 14 18 L 20 2 L 26 18 L 34 6 L 36 26 Z" /></svg>
              </li>
              <li class="badge">
                <span class="b-it">{riderPage.badges.europa.top}</span>
                <span class="b-mk marker">{riderPage.badges.europa.marker} <span data-ink aria-hidden="true" style="display:inline-block">{riderPage.badges.europa.ink}</span></span>
              </li>
              <li class="badge">
                <span class="b-cond">{riderPage.badges.junior.top}</span>
                <span class="b-tiny">{riderPage.badges.junior.mid}</span>
                <span class="b-low">{riderPage.badges.junior.low}</span>
              </li>
              <li class="badge badge--spin">
                <span class="b-label">{riderPage.badges.spin.label}</span>
                <span class="b-num">{riderPage.badges.spin.value}<svg class="mk" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none" style="left:-10%;top:-12%;width:120%;height:122%" fill="none" stroke="#BA1422" stroke-width="3" stroke-linecap="round"><path data-draw vector-effect="non-scaling-stroke" d={circleD} /></svg></span>
              </li>
              <li class="badge">
                <span class="b-label">{riderPage.badges.trick.label}</span>
                <span class="b-trick marker">{riderPage.badges.trick.value}<svg class="mk mk-nf" aria-hidden="true" viewBox="0 0 100 14" preserveAspectRatio="none" style="left:0;bottom:-10px;width:100%;height:12px" fill="none" stroke="#BA1422" stroke-width="2.4" stroke-linecap="round"><path data-draw vector-effect="non-scaling-stroke" d="M2 10 C 30 2, 60 14, 98 4 M10 13 C 40 8, 70 12, 92 9" /></svg></span>
              </li>
              <li class="badge">
                <span class="b-label">{riderPage.badges.stance.label}</span>
                <span class="b-stance">{riderPage.badges.stance.value}<svg class="mk" aria-hidden="true" viewBox="0 0 20 40" style="right:-26px;top:-6px;width:20px;height:40px" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw d="M2 2 L 18 10 L 2 18 L 18 26 L 2 34" stroke="#BA1422" stroke-width="2.5" /></svg></span>
              </li>
            </ul>
          </div>

          <div class="boards">
            <div class="boards__row">
              <svg class="mk" aria-hidden="true" viewBox="0 0 100 40" preserveAspectRatio="none" style="left:8%;top:-56px;width:88%;height:44px" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d="M2 38 C 20 4, 70 -6, 96 26 M89 18 L 97 27 L 99 15" stroke="#BA1422" stroke-width="3" /><path data-draw vector-effect="non-scaling-stroke" d="M30 26 L 34 32 M50 20 L 52 27 M70 22 L 70 29" stroke="#BA1422" stroke-width="2" /></svg>
              <span class="boards__pro marker" data-ink aria-hidden="true">{riderPage.notes.pro}</span>
              <span class="stamp stamp--boards" data-stamp="1.15" aria-hidden="true">{riderPage.notes.stamp}</span>
              {riderPage.boards.map((b, i) => (
                <figure class="board">
                  {i === 0 && <svg class="mk" aria-hidden="true" viewBox="0 0 60 40" style="top:-34px;left:50%;width:46px;margin-left:-23px" fill="none" stroke="#BA1422" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path data-draw d="M6 34 L 9 8 L 21 24 L 30 4 L 39 24 L 51 8 L 54 34 Z M8 38 L 52 37" /></svg>}
                  <div class="board__tag">{b.tag && <span>{b.tag}</span>}</div>
                  <div class="board__drop" data-drop>
                    <div class="board__card" data-spin={i} role="button" tabindex="0" aria-label={b.spinLabel}>
                      <div class="board__face"><Image src={boardImgs[b.top]} alt={b.alt} format="webp" loading="lazy" widths={[110, boardImgs[b.top].width]} sizes={boardSizes} draggable="false" /></div>
                      <div class="board__edge" aria-hidden="true"></div>
                      <div class="board__face board__face--base"><Image src={boardImgs[b.base]} alt="" format="webp" loading="lazy" widths={[110, boardImgs[b.base].width]} sizes={boardSizes} draggable="false" /></div>
                    </div>
                  </div>
                  <div class="board__shadow" aria-hidden="true"></div>
                  <figcaption><span class="board__big">{b.big}</span><span class="board__small">{b.small}</span></figcaption>
                  {i === 0 && <span class="board__one marker" data-ink aria-hidden="true">{riderPage.notes.one}</span>}
                  {i === 0 && <span class="board__egg marker" data-egg data-nocopy aria-hidden="true">{riderPage.notes.egg}</span>}
                </figure>
              ))}
            </div>
            <p class="boards__hint">{riderPage.hint}</p>
          </div>
        </div>
      </div>
      <Wear tone="L" />
    </section>

    <!-- ======================= 03 NEXT CAMP ======================= -->
    <section class="page signal nextcamp" id="next-camp" data-page="2" data-tone="L" data-head="red" aria-labelledby="h-next-camp">
      <div class="nextcamp__photo" aria-hidden="true">
        <Image src={jump} alt="" widths={[480, 640]} sizes="(min-width: 900px) 50vw, 100vw" format="webp" loading="lazy" />
      </div>
      <div class="nextcamp__inner scroller" data-scroll>
        <div class="decor" aria-hidden="true">
          <span class="crop crop--tl"></span><span class="crop crop--br"></span>
          <span class="vtext nextcamp__vt">BAS★CAMP · Issue 01 · Italy · 23—27.12.2026 · Snowboard + Freeski</span>
          <span class="barcode nextcamp__bar hide-m"><i></i><span>BAS 2026 1223 27</span></span>
          <Splat class="nextcamp__splat" a="#E1EFFA" b="#101314" stamp="1.2" />
        </div>
        <div class="nextcamp__top">
          <span class="logo-box logo-box--lg" aria-hidden="true">BAS<b>★</b>CAMP</span>
          <span class="nextcamp__issue">{nextCamp.issue}</span>
          <span class="stamp stamp--ice" data-stamp="0.85" aria-hidden="true">{nextCamp.stamp}</span>
        </div>
        <div class="nextcamp__main">
          <p class="kicker kicker--ice">{nextCamp.kicker}</p>
          <h2 class="nextcamp__place" id="h-next-camp" tabindex="-1"><span class="sr-only">{camp.name} {camp.issue}: </span>{nextCamp.place}<svg class="mk" aria-hidden="true" viewBox="0 0 100 100" style="right:-.3em;top:-.06em;width:.34em;height:.34em" fill="none" stroke="#E1EFFA" stroke-width="4" stroke-linejoin="round"><path data-draw d={burstD} /></svg><span class="stamp stamp--ice stamp--big nextcamp__stamp" data-stamp="0.85" aria-hidden="true">{nextCamp.stamp}</span></h2>
          <p class="nextcamp__dates"><span>{nextCamp.dates[0]}</span> <span>{nextCamp.dates[1]}</span><svg class="mk" aria-hidden="true" viewBox="0 0 100 16" preserveAspectRatio="none" style="left:0;bottom:-.14em;width:100%;height:.2em" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d={dblD} stroke="#E1EFFA" stroke-width="4" /></svg></p>
          <ul class="nextcamp__facts" role="list">{nextCamp.facts.map((f) => <li>{f}</li>)}</ul>
          <p class="nextcamp__line">{nextCamp.line}</p>
          <div class="nextcamp__go">
            <a class="btn btn--ice btn--lg" href="/camp">{nextCamp.cta} <span aria-hidden="true">→</span></a>
            <span class="nextcamp__note marker" data-ink aria-hidden="true">{nextCamp.note}</span>
            <svg class="mk nextcamp__arrow" aria-hidden="true" viewBox="0 0 80 50" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw d="M74 6 C 60 36, 34 44, 10 40 M22 30 L 9 40 L 22 48" stroke="#E1EFFA" stroke-width="3" /></svg>
          </div>
        </div>
      </div>
      <Wear tone="L" />
    </section>

    <!-- ======================= 04 FROM RIDER TO COACH ======================= -->
    <section class="page dark coach" id="coaching" data-page="3" data-tone="D" data-head="dark" aria-labelledby="h-coaching">
      <div class="scroller" data-scroll>
        <div class="pg coach__grid">
          <div class="decor" aria-hidden="true">
            <span class="crop crop--tl"></span><span class="crop crop--br"></span>
            <span class="vtext coach__vt hide-m">Watch · Understand · Adjust · Repeat · Watch · Understand</span>
            <svg class="mk coach__x" viewBox="0 0 60 40" fill="none" stroke-linecap="round"><path data-draw d={xD} stroke="#FF94E3" stroke-width="3.5" /></svg>
            <Splat class="coach__splat hide-m" a="#BA1422" b="#FF94E3" stamp="1.1" />
          </div>
          <header class="pg__head coach__head">
            <p class="kicker"><span class="kicker__n">04</span>{coachPage.kicker}</p>
            <span class="stamp stamp--ice coach__stamp" data-stamp="0.8" aria-hidden="true">Coach mode: on</span>
            <h2 class="h2 coach__h2" id="h-coaching" tabindex="-1">
              {coachPage.h2.map(([n, rest], i) => <span class="coach__line"><em>{n}{i === 1 && <svg class="mk" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none" style="left:-28%;top:-8%;width:156%;height:112%" fill="none" stroke="#FF94E3" stroke-width="3" stroke-linecap="round"><path data-draw vector-effect="non-scaling-stroke" d={circleD} /></svg>}</em> {rest}</span>)}
            </h2>
            <p class="coach__lead"><strong>{coachPage.lead}</strong> {coachPage.leadMore}</p>
          </header>
          <div class="loop">
            <p class="loop__label">{coachPage.loopLabel}<svg class="mk" aria-hidden="true" viewBox="0 0 20 40" style="right:-28px;top:-8px;width:14px;height:28px" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw d={zigD} stroke="#FF94E3" stroke-width="2.5" /></svg></p>
            <ol class="loop__steps" role="list">
              {coachPage.loop.map((s, i) => (
                <li class="loop__step"><span class="loop__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="loop__w">{s.word}</span><span class="loop__l">{s.line}</span></li>
              ))}
            </ol>
          </div>
          <ul class="tags coach__tags" role="list">{coachPage.support.map((t) => <li>{t}</li>)}</ul>
          <figure class="coach__media tilt">
            <span class="tape coach__tape1" aria-hidden="true"></span><span class="tape coach__tape2" aria-hidden="true"></span>
            <!-- TODO(coachingMedia): a coaching photo or clip replaces this placeholder -->
            <div class="ph ph--dark" aria-hidden="true"><span class="ph__top"><span class="ph__rec">REC</span><span>{coachPage.media.label}</span></span><span class="ph__play"></span><span class="ph__cap">{coachPage.media.cap}</span></div>
          </figure>
        </div>
      </div>
      <Wear tone="D" />
    </section>

    <!-- ======================= 05 STUDENT PROGRESS ======================= -->
    <section class="page paper progress" id="progress" data-page="4" data-tone="L" data-head="light" aria-labelledby="h-progress">
      <div class="staple" style="top:28%" aria-hidden="true"></div>
      <div class="staple" style="top:72%" aria-hidden="true"></div>
      <div class="scroller" data-scroll>
        <div class="pg progress__grid">
          <div class="decor" aria-hidden="true">
            <span class="crop crop--tl"></span><span class="crop crop--br"></span>
            <span class="reg progress__reg hide-m"></span>
          </div>
          <header class="pg__head progress__head">
            <p class="kicker"><span class="kicker__n">05</span>{progress.kicker}</p>
            <span class="stamp progress__stamp" data-stamp="0.7" aria-hidden="true">{progress.stamp}</span>
            <h2 class="h2 progress__h2" id="h-progress" tabindex="-1"><span class="progress__pre">{progress.h2[0]}<svg class="mk" aria-hidden="true" viewBox="0 0 100 20" preserveAspectRatio="none" style="left:-1%;top:46%;width:102%;height:.5em" fill="none" stroke-linecap="round"><path data-draw vector-effect="non-scaling-stroke" d="M1 12 C 30 6, 60 15, 99 7" stroke="#BA1422" stroke-width="3" /></svg></span> <span class="progress__main">{progress.h2[1]}<svg class="mk" aria-hidden="true" viewBox="0 0 100 16" preserveAspectRatio="none" style="left:0;bottom:-.08em;width:100%;height:.14em" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d={dblD} stroke="#101314" stroke-width="4" /></svg></span></h2>
            <span class="progress__note marker" data-ink aria-hidden="true">{progress.note}</span>
          </header>
          <div class="car car--cases" data-carousel role="region" aria-roledescription="carousel" aria-label={progress.carousel}>
            <div class="car__viewport" data-car-viewport>
              <ol class="car__track" data-car-track role="list">
                {progress.cases.map((c, i) => (
                  <li class="slide case" data-slide data-case aria-roledescription="slide" aria-label={ui.slide(i + 1, progress.cases.length)}>
                    <figure class="case__media">
                      <span class="tape case__tape" aria-hidden="true"></span>
                      {/* TODO(studentCases): set video.src (vertical clip) and video.poster in site.ts */}
                      {c.video?.poster && <img class="case__poster" src={c.video.poster} alt="" loading="lazy" />}
                      {!c.video?.src && !c.video?.poster && (
                        <div class="ph ph--light" aria-hidden="true"><span class="ph__top"><span class="ph__rec">REC</span><span>{progress.labels.video} {c.n}</span></span><span class="ph__play"></span><span class="ph__cap">[Vertical video]</span></div>
                      )}
                      {c.video?.src && <video muted loop playsinline preload="none" poster={c.video.poster} src={c.video.src}></video>}
                      {c.video?.src && <button class="case__play" type="button" data-case-play aria-pressed="false" aria-label={progress.labels.play(c.n)} data-play={progress.labels.play(c.n)} data-pause={progress.labels.pause(c.n)}><span aria-hidden="true"></span></button>}
                    </figure>
                    <div class="case__body">
                      <p class="case__n">Rider {c.n}</p>
                      <h3 class="case__rider">{c.rider}</h3>
                      <p class="case__tag">{c.tag}</p>
                      <ol class="case__steps" role="list">
                        <li><span class="case__k">{progress.labels.start}</span><span class="case__v">{c.start}</span></li>
                        <li><span class="case__k">{progress.labels.work}</span><span class="case__v">{c.work}</span></li>
                        <li class="case__res"><span class="case__k">{progress.labels.result}</span><span class="case__v">{c.result}</span></li>
                      </ol>
                      {c.quote && <blockquote class="case__quote">“{c.quote}”</blockquote>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
            <div class="car__bar">
              <span></span>
              <div class="car__ctrl">
                <button class="car__btn" type="button" data-car-prev aria-label={ui.prev}>←</button>
                <span class="car__count" data-car-count aria-hidden="true">01/03</span>
                <button class="car__btn" type="button" data-car-next aria-label={ui.next}>→</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <Wear tone="L" />
    </section>

    <!-- ======================= 06 WAYS TO TRAIN ======================= -->
    <section class="page dark train" id="train" data-page="5" data-tone="D" data-head="dark" aria-labelledby="h-train">
      <div class="scroller" data-scroll>
        <div class="pg train__grid">
          <div class="decor" aria-hidden="true">
            <span class="crop crop--tl"></span><span class="crop crop--br"></span>
            <Splat class="train__splat hide-m" stamp="1" />
            <svg class="mk train__x hide-m" viewBox="0 0 60 40" fill="none" stroke-linecap="round"><path data-draw d={xD} stroke="#BA1422" stroke-width="3.5" /></svg>
          </div>
          <header class="pg__head train__head">
            <p class="kicker"><span class="kicker__n">06</span>{train.kicker}</p>
            <h2 class="h2" id="h-train" tabindex="-1">{train.h2[0]} <span class="u">{train.h2[1]}<svg class="mk" aria-hidden="true" viewBox="0 0 100 16" preserveAspectRatio="none" style="left:0;bottom:-.08em;width:100%;height:.14em" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw vector-effect="non-scaling-stroke" d={dblD} stroke="#FF94E3" stroke-width="4" /></svg></span></h2>
            <span class="train__note marker" data-ink aria-hidden="true">{train.note}</span>
          </header>
          <div class="options">
            <article class="opt tilt" aria-labelledby="h-opt-a">
              <div class="opt__media"><Image src={rail} alt={train.coaching.alt} widths={[480, 960]} sizes="(min-width: 900px) 40vw, 100vw" format="webp" loading="lazy" style="object-position:50% 35%" /></div>
              <div class="opt__body">
                <p class="opt__label"><span>{train.coaching.label}</span></p>
                <h3 class="opt__title" id="h-opt-a">{train.coaching.title}</h3>
                <p class="opt__price"><strong>{train.coaching.price}<svg class="mk" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none" style="left:-12%;top:-14%;width:124%;height:128%" fill="none" stroke="#FF94E3" stroke-width="3" stroke-linecap="round"><path data-draw vector-effect="non-scaling-stroke" d={circleD} /></svg></strong> <span class="opt__per">{train.coaching.per}</span> <span class="opt__day">{train.coaching.day}</span></p>
                <p class="opt__text">{train.coaching.body}</p>
                <ul class="tags tags--sm" role="list">{train.coaching.areas.map((a) => <li>{a}</li>)}</ul>
                <div class="opt__cta">
                  <a class="btn btn--red" href={rider.dmUrl} {...ext}>{train.coaching.cta} <span aria-hidden="true">↗</span><span class="sr-only"> {ui.newTab}</span></a>
                  <p class="opt__note">{train.coaching.note}</p>
                </div>
              </div>
            </article>
            <article class="opt opt--camp tilt" aria-labelledby="h-opt-b">
              <span class="sticker sticker--red opt__sticker" data-stamp="0.9" aria-hidden="true">{train.camp.sticker}</span>
              <span class="train__or marker" data-ink aria-hidden="true">{train.or}</span>
              <div class="opt__media"><Image src={glacier} alt={train.camp.alt} widths={[480, 960]} sizes="(min-width: 900px) 40vw, 100vw" format="webp" loading="lazy" style="object-position:50% 40%" /></div>
              <div class="opt__body">
                <p class="opt__label"><span>{train.camp.label}</span></p>
                <h3 class="opt__title" id="h-opt-b">{train.camp.title}</h3>
                <p class="opt__lines">{train.camp.lines.map((l) => <span>{l}</span>)}</p>
                <dl class="opt__facts">
                  <div><dt>{train.camp.next}</dt><dd>{train.camp.when} · {train.camp.where}</dd></div>
                  <div><dt class="sr-only">Disciplines</dt><dd>{train.camp.disciplines}</dd></div>
                </dl>
                <div class="opt__cta">
                  <a class="btn btn--dark" href="/camp">{train.camp.cta} <span aria-hidden="true">→</span></a>
                  <p class="opt__price opt__price--inline"><strong>{train.camp.price}</strong></p>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
      <Wear tone="D" />
    </section>

    <!-- ======================= 07 YOUR NEXT LEVEL ======================= -->
    <section class="page dark final" id="next-level" data-page="6" data-tone="D" data-head="dark" aria-labelledby="h-next-level">
      <div class="final__photo" aria-hidden="true">
        <Image src={bib} alt="" widths={[480, 854]} sizes="(min-width: 900px) 40vw, 90vw" format="webp" loading="lazy" />
      </div>
      <div class="final__inner scroller" data-scroll>
        <div class="decor" aria-hidden="true">
          <span class="crop crop--tl"></span><span class="crop crop--tr"></span>
          <Splat class="final__splat" stamp="1" />
          <svg class="mk final__x" viewBox="0 0 60 40" fill="none" stroke-linecap="round"><path data-draw d={xD} stroke="#BA1422" stroke-width="3.5" /></svg>
        </div>
        <span class="stamp stamp--pink final__stamp" data-stamp="0.8" aria-hidden="true">{nextLevel.stamp}</span>
        <h2 class="final__h2" id="h-next-level" tabindex="-1">{nextLevel.h2[0]}<br /><span class="u">{nextLevel.h2[1]}<svg class="mk" aria-hidden="true" viewBox="0 0 60 60" style="right:-.55em;top:-.1em;width:.42em;height:.42em" fill="none" stroke="#FF94E3" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path data-draw d={starD} /></svg></span></h2>
        <div class="paths">
          <span class="final__pick marker" data-ink aria-hidden="true">{nextLevel.pick}</span>
          <svg class="mk final__arrow" aria-hidden="true" viewBox="0 0 40 70" fill="none" stroke-linecap="round" stroke-linejoin="round"><path data-draw d={downD} stroke="#FF94E3" stroke-width="3" /></svg>
          {nextLevel.paths.map((p) => (
            <a class:list={['path', `path--${p.kind}`]} href={p.kind === 'camp' ? '/camp' : rider.dmUrl} {...(p.kind === 'camp' ? {} : ext)}>
              <span class="path__label">{p.label}</span>
              <span class="path__sub">{p.sub}</span>
              <span class="path__cta">{p.cta} <span aria-hidden="true">{p.kind === 'camp' ? '→' : '↗'}</span></span>
              {p.kind !== 'camp' && <span class="sr-only"> {ui.newTab}</span>}
            </a>
          ))}
        </div>
        <p class="final__ig"><span class="final__ig-l">{nextLevel.social}</span> <a href={rider.instagramUrl} {...ext}>@{rider.instagram} <span aria-hidden="true">↗</span></a></p>
        <p class="final__contact"><a href={rider.phoneHref}>{rider.phone}</a> <span aria-hidden="true">·</span> <a href={`mailto:${rider.email}`}>{rider.email}</a></p>
        <footer class="final__foot">
          <span class="logo-box" aria-hidden="true">{brand.logo}<b>★</b></span>
          <span>{nextLevel.footer.issue}</span>
          <span>{nextLevel.footer.copyright}</span>
          <a class="btn-line totop" href="#cover" data-go="0">{nextLevel.footer.toTop}</a>
        </footer>
      </div>
      <Wear tone="D" />
    </section>
  </main>

  <Stage />
  <canvas class="paper-canvas" aria-hidden="true" data-paper-canvas></canvas>

  <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label={ui.contents} hidden data-menu>
    <div class="menu__head">
      <span class="menu__kicker">{ui.contents}</span>
      <button class="btn-line" type="button" data-menu-close>{ui.close}</button>
    </div>
    <nav aria-label={ui.pagesNav}>
      <ol>
        {pages.map((p, i) => (
          <li><a class="menu__item" href={`#${p.id}`} data-go={i} aria-current={i === 0 ? 'page' : undefined}><span class="menu__num">{p.num}</span><span class="menu__title">{p.title}</span></a></li>
        ))}
      </ol>
    </nav>
    <div class="menu__foot">
      <a class="btn btn--red" href="/camp">{nav.cta}</a>
      <a class="menu__ig" href={rider.instagramUrl} {...ext}>Instagram @{rider.instagram} <span aria-hidden="true">↗</span></a>
    </div>
  </div>

</div>

<script>
  import '../scripts/magazine';
</script>
</Base>
