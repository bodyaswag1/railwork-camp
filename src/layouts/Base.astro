---
import '../styles/tokens.css';
// preload the two faces every page renders above the fold, so headlines don't reflow when they swap in
import archivoWoff from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import onestWoff from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  bodyClass?: string;
}
const { title, description, path, jsonLd = [], bodyClass } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const og = new URL('/og.jpg', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#101314" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoWoff} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={onestWoff} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/MostWazted.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" is:inline set:html={JSON.stringify(d)} />)}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
